{
  "name": "@mktos/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mktos-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "chamar": "tsx scripts/chamar.ts",
    "test": "node --test test/env.test.mjs test/identidade.test.mjs test/rotas.test.mjs test/contratos.test.mjs",
    "gerar-rotas": "tsx scripts/gerar-rotas.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
