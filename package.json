{
  "name": "marketing-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:test": "pnpm --filter @mktos/api typecheck:test",
    "db:generate": "pnpm --filter @mktos/api db:generate",
    "db:migrate": "pnpm --filter @mktos/api db:migrate",
    "db:deploy": "pnpm --filter @mktos/api db:deploy",
    "db:diff": "pnpm --filter @mktos/api db:diff",
    "db:seed": "pnpm --filter @mktos/api db:seed",
    "test": "turbo run test",
    "test:isolamento": "pnpm --filter @mktos/api test:isolamento"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
