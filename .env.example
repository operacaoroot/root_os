# ============================================================
# Marketing OS — exemplo de variáveis de ambiente
# Produto do projeto ROOT. Stack ISOLADO (ver docs/ISOLATION.md).
# Copie para .env e preencha. NUNCA commite o .env real.
# NUNCA aponte para serviços/credenciais do escritório C&S.
# ============================================================

# --- App ---
APP_NAME="Marketing OS"
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:4001

# --- Portas host (faixa própria, sem colisão com o escritório) ---
WEB_PORT=4000
API_PORT=4001
DB_PORT=5442
REDIS_PORT=6390
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# --- Banco / cache (instâncias PRÓPRIAS deste stack) ---
DB_USER=mkt
DB_PASSWORD=mkt
DB_NAME=marketing_os
DATABASE_URL=postgresql://mkt:mkt@localhost:5442/marketing_os
REDIS_URL=redis://localhost:6390

# --- Segurança ---
# Chave mestra p/ criptografar tokens de integração (AES-256-GCM). Gere: openssl rand -base64 32
ENCRYPTION_KEY=
AUTH_SECRET=            # openssl rand -base64 32
JWT_SECRET=

# --- Storage (S3 compatível: MinIO próprio ou R2) ---
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=marketing-os
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- IA (LLMProvider) ---
LLM_PROVIDER=anthropic         # anthropic | openai | local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=

# --- WhatsApp (WhatsappProvider genérico — conta/número PRÓPRIOS, nunca o do escritório) ---
WHATSAPP_PROVIDER=             # meta | zapi | 360dialog | outro
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_ALERT_RECIPIENTS=     # números autorizados, separados por vírgula

# --- Google (Gmail + Drive) — app/projeto próprios do Marketing OS ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/api/integrations/google/callback

# --- Meta / Instagram — app próprio ---
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4001/api/integrations/instagram/callback

# --- ClickUp / Asana — workspace/token próprios ---
CLICKUP_TOKEN=
ASANA_TOKEN=

# --- Financeiro: Asaas (cobranças + conta digital) — conta PRÓPRIA do root ---
# Chave em: painel Asaas → Configurações → Integrações → API. Ambiente é
# auto-detectado pela chave ($aact_prod_ = produção · $aact_hmlg_ = sandbox).
# Em produção guarde em ~/.config/root/asaas.env (nunca no repo).
ASAAS_API_KEY=
ASAAS_BASE_URL=                # opcional: força a base (senão deriva da chave)
ASAAS_SYNC_INTERVAL_MIN=360    # auto-sync a cada N min (0 desliga)

# --- Financeiro: Pluggy (Open Finance) — opcional ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_SYNC_INTERVAL_MIN=360

# --- Automações ---
ZAPIER_WEBHOOK_SECRET=
APIFY_TOKEN=

# --- Pixel ---
PIXEL_ALLOWED_ORIGINS=         # domínios das páginas de vendas, separados por vírgula
