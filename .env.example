# ============================================================
# ROOT OS (repositório marketing-os) — exemplo de variáveis de ambiente
# Stack ISOLADO do escritório C&S (ver docs/ISOLATION.md).
# Copie para .env e preencha. NUNCA commite o .env real.
#
# ONDE CADA COISA É LIDA (a pegadinha que mais custa tempo — ver CLAUDE.md):
#  - Container: NÃO lê arquivo .env. Só chega o que está no bloco `environment:`
#    do serviço em docker-compose.yml. Este arquivo serve ao compose para
#    interpolar ${VAR} naquele bloco.
#  - `pnpm --filter @mktos/api dev` (sem docker): o Nest lê o .env do cwd, ou
#    seja `apps/api/.env`.
#  - Variável nova = adicionar em DOIS lugares: o bloco `environment:` do
#    compose E este arquivo.
#
# Este arquivo cobre 100% das variáveis interpoladas em docker-compose.yml
# (conferido em 10/09/2026) mais as usadas só por teste.
# ============================================================

# --- App ---
APP_NAME="ROOT OS"                 # nome exibido na interface (packages/shared)
NODE_ENV=development               # development | production
# URL pública da API/painel. Usada para montar link absoluto (ex.: avatar da bio).
PUBLIC_BASE_URL=http://localhost:4000
# Origem do painel autorizada no CORS da API e no retorno do login Google.
WEB_ORIGIN=http://localhost:4000

# --- Portas host (faixa própria, sem colisão com o escritório) ---
WEB_PORT=4000                      # painel Next.js
API_PORT=4001                      # API NestJS
DB_PORT=5442                       # Postgres
REDIS_PORT=6390                    # Redis
MINIO_PORT=9010                    # MinIO — API S3
MINIO_CONSOLE_PORT=9011            # MinIO — console web

# --- Banco / cache (instâncias PRÓPRIAS deste stack) ---
DB_USER=mkt                        # dono das tabelas (só o compose local usa este valor)
DB_PASSWORD=                       # PLACEHOLDER — gere: openssl rand -base64 24
DB_NAME=marketing_os
# Conexão usada fora do docker (pnpm dev, prisma migrate, scripts).
# Precisa repetir usuário/senha/porta/banco das quatro linhas acima.
DATABASE_URL=postgresql://mkt:SENHA@localhost:5442/marketing_os

# --- O papel RESTRITO com que a aplicação conecta (RF-T-02) ---
# `mktos_app` é criado NOLOGIN pela migration 20260911020000_papel_de_aplicacao:
# lê e escreve dado, não cria estrutura, não altera nem apaga EventLog, e NÃO
# tem BYPASSRLS. Só o dono das tabelas ignora policy de isolamento por linha —
# por isso a aplicação precisa parar de ser o dono ANTES de o isolamento valer.
#
# Só o USUÁRIO e a SENHA entram aqui: host, porta e banco saem da DATABASE_URL
# acima, reescritos em memória (ver urlDaAplicacao em sessao-de-banco.ts). Duas
# URLs completas a manter em sincronia é o erro que só aparece no deploy.
#
# VAZIO = a aplicação segue conectando como DONA, como sempre foi. Nada quebra;
# o isolamento é que fica inerte, e o boot da API diz isso no log.
#
# Para provisionar (a senha nunca entra em arquivo versionado):
#   DB_APP_PASSWORD='...' deploy/papel-app.sh          # local
#   DB_APP_PASSWORD='...' deploy/papel-app.sh --vps    # servidor
DB_APP_USER=mktos_app
# Gere SEM "%": openssl rand -hex 32  (um "%" literal não sobrevive à URL de
# conexão, e a aplicação recusa subir em vez de conectar com senha errada)
DB_APP_PASSWORD=
# Escape para a aplicação falar com outro host (pgbouncer). Preenchida, vence as
# duas de cima.
APP_DATABASE_URL=
# observar (padrão) | impor. Em `observar`, consulta sem empresa resolvida roda
# com app.org_id vazio e o caminho é registrado UMA vez no log — é o inventário
# do que falta antes de ligar o isolamento. Em `impor`, ela LANÇA (RF-T-04) e a
# API se recusa a subir sem o papel restrito provisionado.
TENANT_MODO=observar

# --- Segurança ---
# Chave mestra p/ cifrar tokens de integração (AES-256-GCM). Gere: openssl rand -base64 32
# Trocar sem re-cifrar torna TODOS os tokens ilegíveis (ver apps/api/prisma/migrate-bio.ts).
ENCRYPTION_KEY=
AUTH_SECRET=                       # segredo de sessão — openssl rand -base64 32
JWT_SECRET=                        # assinatura do JWT da API — openssl rand -base64 32

# --- Contas de serviço (SEM default fraco no código/compose) ---
# Gere fortes:  openssl rand -base64 24
# Depois de definir aqui, rode `pnpm db:seed` para rotacionar os hashes e
# reinicie api+telegram — senão o login falha.
# ⚠️ NUNCA rode `db:seed` em produção: ele apaga leads, eventos de pixel,
# tarefas e campanhas do org e recria dados de exemplo. Para só registrar
# permissões novas use `db:sync-permissions` (aditivo, não apaga nada).
#
# ⚠️ As duas senhas de MCP abaixo travam o compose INTEIRO enquanto estiverem
# vazias: o serviço `telegram` as interpola com `${VAR:?...}`, e a forma com
# dois-pontos falha com variável VAZIA, não só ausente. Como o compose
# interpola o arquivo inteiro antes de escolher o serviço, sem elas nem
# `docker compose ps` roda — muito menos `up api`. Preencha antes do 1º up.
ADMIN_PASSWORD=
MCP_SERVICE_EMAIL=mcp@marketing-os.local      # conta só-leitura usada pelo MCP/IA
MCP_SERVICE_PASSWORD=                          # obrigatória: `:?` no compose; VAZIA falha igual a ausente
MCP_ACTION_EMAIL=ia-acao@marketing-os.local   # conta de AÇÃO (escreve só o aprovado por humano)
MCP_ACTION_PASSWORD=                           # obrigatória: `:?` no compose; VAZIA falha igual a ausente

# --- A PORTA (Tool Gateway) e o RASTRO ---
# `observar` afrouxa o REGISTRO, nunca o EFEITO: a porta classifica tudo, grava
# cada decisão com `modo=observar` e é dessa tabela que sai o relatório de
# calibragem (apps/api/src/scripts/relatorio-observar.ts).
# Os dois freios valem IGUAL nos dois modos: o bloqueio (R5, e capacidade sem
# classificação, que vale R5) recusa sem chamar o efeito, e a retenção por
# aprovação (R3/R4 sempre, R2 com a aprovação configurável ligada) cria a
# aprovação sem chamar o efeito.
# Argumento fora do schema e capacidade fora das declaradas são recusados ANTES
# de o modo ser consultado.
# Lida no CONSTRUTOR: `docker restart` não troca o valor — use
# `docker compose ... up -d --no-build api`.
GATEWAY_MODO=observar              # observar | impor
RASTRO_RETENCAO_DIAS=1825          # retenção do EventLog em dias (hoje global, não por tenant)

# --- Storage (S3 compatível: MinIO próprio ou R2) ---
# Fora do docker use a URL completa; dentro do compose o endpoint é o NOME do
# serviço (`minio`), porque o MinIO não é público — quem entrega a imagem ao
# browser é a própria API, em /api/bio/avatar/:arquivo.
S3_ENDPOINT=http://localhost:9010
S3_PORT=9000                       # porta do MinIO dentro da rede do compose
S3_USE_SSL=false                   # true quando o endpoint for HTTPS (R2, S3 real)
S3_BUCKET=marketing-os
S3_ACCESS_KEY=minioadmin           # PLACEHOLDER — troque em produção
S3_SECRET_KEY=minioadmin           # PLACEHOLDER — troque em produção

# --- IA (LlmProvider) ---
LLM_PROVIDER=anthropic             # anthropic | openai | openrouter | local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high              # low | medium | high | xhigh | max
ANTHROPIC_MAX_TOKENS=16000         # teto de pensamento + resposta juntos
# OpenAI segue necessário para EMBEDDINGS (a Anthropic não tem esse endpoint).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=                   # opcional: aponta para um gateway compatível
# OpenRouter: mesma API de Chat Completions, com custo medido em `usage.cost`.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=               # opcional: sobrescreve https://openrouter.ai/api/v1

# --- Google (Gmail + Drive + Agenda) — app/projeto próprios do ROOT OS ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Path real do callback de CONEXÃO (google.service.ts). Precisa bater com o console.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
# Login com o Gmail: e-mails que podem entrar criando usuário na hora.
# Vazio = ninguém novo entra (só quem já é usuário).
GOOGLE_LOGIN_ALLOWED_EMAILS=
# Só se o login tiver URI própria registrada; vazio cai no GOOGLE_REDIRECT_URI.
GOOGLE_LOGIN_REDIRECT_URI=

# --- Meta / Instagram (métricas) — app próprio ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/meta/callback

# --- Link na bio (absorvido do root-bio) ---
# Domínio público da bio. O mktos_web responde nele e reescreve /@handle → /b/handle.
BIO_HOST=bio.operacaoroot.com
# Usado para montar a redirect URI do OAuth. Precisa bater EXATAMENTE com o que
# está registrado nos consoles da Meta e do TikTok:
#   https://bio.operacaoroot.com/api/conectar/{instagram,tiktok}/callback
PUBLIC_BIO_ORIGIN=https://bio.operacaoroot.com
# Credenciais dos apps de plataforma. Podem ficar vazias: a tela /bio → Conexões
# grava no banco (cifradas) e tem precedência sobre estas.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Coleta de posts do desafio (0 desliga). Também é o que mantém o token do
# Instagram vivo — ele expira de vez após 60 dias sem uso.
BIO_SYNC_INTERVAL_MIN=360
# Recálculo de GoalWeek.bioClicks a partir dos cliques (0 desliga).
BIO_BRIDGE_INTERVAL_MIN=720
# Migração única do banco antigo (ver apps/api/prisma/migrate-bio.ts):
# BIO_DATABASE_URL=postgresql://...root_bio-db...
# BIO_OLD_ENCRYPTION_KEY=          # só se a chave do root-bio for diferente da acima

# --- Obsidian (base de conhecimento, busca semântica) ---
# Caminho NO HOST do vault a montar read-only no container. Na VPS aponta para
# /srv/marketing-os/vault, que NÃO é o vault real do Mac — por isso o espelho
# da pauta tem destino "drive".
OBSIDIAN_VAULT_HOST=
OBSIDIAN_REINDEX_MIN=30            # reindexação periódica em minutos (0 desliga)

# --- ClickUp (módulo Trabalho — workspace/token próprios) ---
# Token PESSOAL de membro (pk_<userId>_): morre quando a pessoa sai do workspace.
CLICKUP_API_TOKEN=
CLICKUP_SPACE_ID=                  # id do espaço a sincronizar (vazio = resolve por nome)
CLICKUP_SPACE_NAME=root            # nome do espaço quando não há id
CLICKUP_IGNORE_TEAMS=Cardozo & Saggioro   # times a ignorar (isolamento do escritório)
CLICKUP_LIST_IDS=                  # listas a sincronizar, separadas por vírgula (vazio = todas)
CLICKUP_CONTENT_LIST_IDS=          # listas tratadas como pauta de conteúdo
CLICKUP_CONTENT_LIST_NAMES=Gestão de Temas   # idem, por nome
CLICKUP_SYNC_INTERVAL_MIN=60       # sincronização periódica em minutos (0 desliga)
CLICKUP_LIST_PAUTA=                # lista onde a peça de canal `clickup` vira tema

# --- Financeiro: Asaas (cobranças + conta digital) — conta PRÓPRIA do root ---
# Chave em: painel Asaas → Configurações → Integrações → API. Ambiente é
# auto-detectado pela chave ($aact_prod_ = produção · $aact_hmlg_ = sandbox).
ASAAS_API_KEY=
ASAAS_BASE_URL=                    # opcional: força a base (senão deriva da chave)
ASAAS_SYNC_INTERVAL_MIN=360        # auto-sync a cada N min (0 desliga)

# --- Financeiro: Pluggy (Open Finance) — opcional ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_SYNC_INTERVAL_MIN=360

# --- Financeiro: aprovação ---
# Valor em R$ acima do qual o lançamento exige aprovação (finance/apr.service.ts).
FINANCE_APPROVAL_LIMIT=5000

# --- Pauta / Referências (docs/PAUTA.md) ---
APIFY_TOKEN=                       # scraping de post/perfil sob demanda (Apify cobra por run)
APIFY_TIMEOUT_SEC=120              # teto do run síncrono (segura a requisição do painel)
# Espelho .md das fichas. O destino também é escolhível na tela (/referencias → Radar),
# e o que estiver salvo lá vence estes defaults.
PAUTA_ESPELHO=off                  # off | local | drive
PAUTA_ESPELHO_DIR=Cerebro-Conteudo/8 - Referência de Conteúdo/fichas-os
PAUTA_DRIVE_FOLDER_ID=             # destino "drive": id da pasta (trecho após /folders/ na URL)
# Gatilho das rotinas. "off" desliga o disparo automático; a tela continua
# deixando rodar na mão. A API é container único — com mais de uma réplica,
# duas instâncias disparariam a mesma rodada.
PAUTA_CRON=on

# --- WhatsApp (Evolution API) ---
# Instância e número DEDICADOS do root (ISOLATION.md). A Cloud API da Meta NÃO
# envia para grupo — por isso Evolution. O JID do grupo termina em @g.us e não
# é o número de telefone.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=
EVOLUTION_GRUPO_JID=

# --- Telegram (serviço `telegram` do compose — só roda no Mac) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=         # chats autorizados, separados por vírgula (vazio = nenhum)
DAILY_REPORT_TIME=08:00            # horário do relatório diário
DAILY_REPORT_TZ=America/Sao_Paulo

# --- Testes (não vão para o container; são do ambiente de teste) ---
# Banco DESCARTÁVEL para as suítes que escrevem. Sem esta variável,
# porta.test.ts e runtime.test.ts se PULAM inteiros e a suíte passa sem testar.
# O nome do banco precisa casar com /test|dev|local|staging|shadow/i.
TEST_DATABASE_URL=postgresql://usuario:senha@localhost:55432/marketing_os_test
# Conexão da APLICAÇÃO (role restrita, sujeita a RLS) usada por
# apps/api/test/tenant-isolation.test.ts. Sem ela, a leitura do teste usa a
# mesma conexão ADMIN da semeadura e o isolamento não é provado de verdade.
TENANT_DATABASE_URL=
# Escape consciente da trava de nome do banco. NÃO defina em máquina que tenha
# acesso a produção.
PERMITIR_BANCO_NAO_TESTE=

# ============================================================
# Declaradas em versões antigas deste arquivo e NÃO lidas por nenhum código
# hoje (10/09/2026). Ficam registradas para não perder a intenção; não
# preencha esperando efeito.
#   REDIS_URL              — o Redis está no compose, mas nenhum serviço o lê ainda
#   CLICKUP_TOKEN          — substituída por CLICKUP_API_TOKEN
#   ASANA_TOKEN            — conector nunca implementado
#   WHATSAPP_PROVIDER / WHATSAPP_API_KEY / WHATSAPP_API_URL /
#   WHATSAPP_ALERT_RECIPIENTS — o WhatsApp real é a Evolution (acima)
#   INSTAGRAM_REDIRECT_URI — a bio monta a URI a partir de PUBLIC_BIO_ORIGIN
#   ZAPIER_WEBHOOK_SECRET  — sem rota de webhook do Zapier
#   PIXEL_ALLOWED_ORIGINS  — o pixel não filtra origem hoje
# ============================================================
