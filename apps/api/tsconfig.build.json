{
  "extends": "./tsconfig.json",
  // `prisma` inteira, não arquivo a arquivo: todo script de lá roda por tsx e
  // nada em src/ importa da pasta. Um único .ts fora de src/ no build sobe a
  // raiz comum do tsc e a saída vira dist/src/main.js — o CMD do Dockerfile e o
  // `start` apontam para dist/main.js, e a API não sobe.
  "exclude": ["node_modules", "dist", "prisma", "**/*.spec.ts"]
}
