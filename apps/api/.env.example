# apps/api/.env — o que `pnpm --filter @mktos/api dev` lê (ConfigModule sem envFilePath → o .env do cwd).
# ATENÇÃO: o container NÃO lê este arquivo; ele só recebe o que está no bloco `environment:` do
# docker-compose.yml, interpolado a partir do .env da RAIZ. Este aqui é só para rodar a API no host.
# Copie: cp apps/api/.env.example apps/api/.env — e nunca versione o .env.

# A ÚNICA obrigatória. Compose local: porta 5442, usuário/senha mkt (ver docker-compose.yml).
DATABASE_URL=postgresql://mkt:mkt@localhost:5442/marketing_os

# Senha do admin@marketing-os.local no primeiro `db:seed`. Vazia → o seed gera uma forte e imprime UMA vez.
ADMIN_PASSWORD=

# Senha da conta de serviço só-leitura que o servidor MCP avulso (packages/mcp) usa. Vazia → gerada no seed.
MCP_SERVICE_PASSWORD=

# Segredos de sessão/JWT. Vazios → 'dev-secret' (só serve para desenvolvimento local).
JWT_SECRET=
AUTH_SECRET=

# Modelo. Vazio → o LLM fica desligado e o laço do agente responde que não há provedor.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Embeddings (a Anthropic não tem esse endpoint). Vazio → a busca cai para textual, explicitamente.
OPENAI_API_KEY=

# A vault do Obsidian, como CAMINHO DE FILESYSTEM deste processo. É a variável que o código lê;
# OBSIDIAN_VAULT_HOST é só do bind mount do compose e não faz nada aqui. Vazia → base de conhecimento off.
OBSIDIAN_VAULT_PATH=
# Reindexação periódica em minutos. 0 desliga o laço — recomendado enquanto se mede o custo de vetorização.
OBSIDIAN_REINDEX_MIN=0

# A porta e o relógio. `observar` classifica e registra sem impor retenção configurável de R2; R3+ retém igual.
GATEWAY_MODO=observar
# `observar` = conexão dona do banco (RLS armado, inerte). `impor` exige DB_APP_USER/DB_APP_PASSWORD.
TENANT_MODO=observar
# `off` cala o agendador de rotinas inteiro (o módulo continua montado).
ROTINAS_CRON=on
