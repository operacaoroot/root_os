// Marketing OS — schema Prisma (Fase 1). Multi-tenant-ready via orgId.
// Ver docs/DATA_MODEL.md. pgvector/embeddings entram na Fase 5.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // pgvector (busca semântica da base de conhecimento)
}

// ============================================================================
// orgId redundante em todo filho de tenant (RF-T-01)
//
// Dez modelos só alcançavam a empresa pelo pai (LeadEvent por Lead, BioLink por
// BioPage, WorkComment por WorkTask...). Consulta que esquece o join sai sem
// tenant, e isolamento por linha no Postgres não tem em que coluna se apoiar.
// Desde `20260910120000_orgid_em_todo_filho` os dez carregam `orgId`.
//
// O `@default("")` NÃO é valor: é sentinela. Um gatilho BEFORE INSERT OR UPDATE
// (`<Tabela>_orgId_do_pai`) troca a sentinela pelo orgId do pai e RECUSA a linha
// cujo orgId não bate com o do pai — é o que impede, NA ESCRITA DO FILHO,
// pendurar filho de uma empresa em pai de outra, coisa que a chave estrangeira
// simples não enxerga. Se um dia o gatilho sumir, a sentinela vira violação de
// FK contra Org: falha fechada e barulhenta, nunca linha órfã de tenant.
//
// Limitação conhecida: mudar o `orgId` do PAI depois deixa o filho na empresa
// antiga — não há gatilho de propagação. O porquê está no cabeçalho da migration
// e em `src/common/modelos-globais.ts`; quem detecta é o teste de isolamento.
//
// WorkFieldValue tem TRÊS pais (tarefa, campo e opção escolhida) e três
// gatilhos: derivar de um só deixaria passar valor com opção de outra empresa.
//
// A sentinela existe para o campo continuar OPCIONAL no `create` do Prisma:
// as ~20 chamadas que hoje criam esses filhos sem informar orgId seguem
// compilando e passam a gravar o tenant certo. Informar orgId explicitamente
// continua sendo o certo — aí o gatilho vira conferência, não mecanismo.
//
// Quem é GLOBAL por desenho (Org, Permission, BioVisitor, Capability) está
// declarado em `src/common/modelos-globais.ts`. O teste de isolamento reprova
// modelo novo sem orgId que não esteja naquela lista.
// ============================================================================

// ---------- Identidade, acesso, auditoria ----------
model Org {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  /// Módulos de domínio contratados por esta empresa — RF-T-06.
  ///
  /// As chaves válidas são as de `MODULOS` em `packages/shared/src/nav.ts`, que
  /// é a fonte única: o menu do web e o guard da API leem a MESMA lista. Nada
  /// aqui é enum do Prisma de propósito — enum viraria uma segunda lista, e
  /// acrescentar módulo passaria a exigir migration de tipo além da de dados.
  ///
  /// VAZIO SIGNIFICA "SÓ A ESPINHA DO OS", não "tudo": um tenant novo nasce sem
  /// módulo nenhum e o que ele enxerga é só o que fala do sistema (central,
  /// quem trabalha, controle, o que existe, a conta). Por isso o default é `[]`
  /// e a migration `20260911013000_modulos_habilitados_por_org` PREENCHE as
  /// empresas que já existiam com a lista inteira — quem já estava dentro não
  /// pode perder tela por causa de uma coluna nova.
  ///
  /// Quem provisiona empresa (seed, script, tela futura) informa este campo
  /// EXPLICITAMENTE. Confiar no default aqui é nascer com o painel vazio.
  modulos String[] @default([])

  users        User[]
  roles        Role[]
  leads        Lead[]
  campaigns    Campaign[]
  tasks        Task[]
  pixelEvents  PixelEvent[]
  auditLogs    AuditLog[]
  integrations IntegrationAccount[]
  leadSources  LeadSource[]
  reports      Report[]
  contentItems ContentItem[]
  knowledge    KnowledgeNote[]
  google       GoogleAccount?
  meta         MetaAccount?
  goalWeeks    GoalWeek[]
  goalConfig   GoalConfig?

  // A régua e a porta (ver "Régua, porta e rastro" no fim do arquivo)
  policyVersions  PolicyVersion[]
  policyDecisions PolicyDecision[]
  toolCalls       ToolCall[]
  approvals       Approval[]
  eventLogs       EventLog[]
  rastroRetencao  RastroRetencao?

  // A tripulação (ver "Tripulação" no fim do arquivo)
  agents      Agent[]
  sessions    Session[]
  identidades ChannelIdentity[]

  financeAccounts     FinanceAccount[]
  financeCategories   FinanceCategory[]
  financeTransactions FinanceTransaction[]
  bankConnections     BankConnection[]
  chartAccounts       ChartAccount[]
  dreLines            DreLine[]
  partners            Partner[]
  departamentos       Departamento[]
  projetos            Projeto[]
  contracts           Contract[]
  transactionSplits   TransactionSplit[]

  workFolders WorkFolder[]
  workLists   WorkList[]
  workTags    WorkTag[]
  workFields  WorkField[]
  workTasks   WorkTask[]

  bioPages       BioPage[]
  bioChallenges  BioChallenge[]
  bioConexoes    BioConexao[]
  bioCredenciais BioCredencialApp[]
  bioOauthStates BioOauthState[]
  bioVisits      BioVisit[]
  bioEvents      BioEvent[]

  pautaFontes      PautaFonte[]
  pautaCapturas    PautaCaptura[]
  pautaReferencias PautaReferencia[]
  pautaRotinas     PautaRotina[]
  pautaRodadas     PautaRodada[]
  pautaPecas       PautaPeca[]

  // Os dez filhos que passaram a carregar orgId (ver bloco no topo do arquivo).
  leadEvents            LeadEvent[]
  integrationHealths    IntegrationHealth[]
  bioLinks              BioLink[]
  bioChallengeAccounts  BioChallengeAccount[]
  bioChallengePosts     BioChallengePost[]
  bioChallengeSnapshots BioChallengeSnapshot[]
  workStatuses          WorkStatus[]
  workFieldOptions      WorkFieldOption[]
  workFieldValues       WorkFieldValue[]
  workComments          WorkComment[]

  // Fatia 3.6 — RF-G-05 (bloco no fim do arquivo). Só o outro lado da relação
  // mora aqui: é o que o Prisma exige, e nada além disso.
  tetoDeCustoIa TetoDeCustoIa?
  gastoDeIaDia  GastoDeIaNoDia[]

  // Fatia 3.7 — RF-G-06 (bloco no fim do arquivo).
  conectoresDesligados ConectorDesligado[]

  // Fatia 5.3 — O COFRE, RF-C-01..04 (bloco no fim do arquivo). Mesma regra das
  // duas de cima: só o outro lado da relação mora aqui, que é o que o Prisma
  // exige, e nada além disso.
  segredosDeConector SegredoDeConector[]
}

model User {
  id           String    @id @default(uuid())
  orgId        String
  org          Org       @relation(fields: [orgId], references: [id])
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles      Role[] @relation("UserRoles")
  ownedLeads Lead[] @relation("LeadOwner")

  agentesQueDono Agent[]           @relation("AgentDono")
  identidades    ChannelIdentity[]

  @@index([orgId])
}

model Role {
  id          String       @id @default(uuid())
  orgId       String
  org         Org          @relation(fields: [orgId], references: [id])
  key         String
  name        String
  users       User[]       @relation("UserRoles")
  permissions Permission[] @relation("RolePermissions")

  @@unique([orgId, key])
}

/// Catálogo GLOBAL de permissões, sem orgId de propósito: a chave é a mesma em
/// toda empresa e quem amarra permissão a empresa é o Role.
/// Declarado em `src/common/modelos-globais.ts`.
model Permission {
  id    String @id @default(uuid())
  key   String @unique
  roles Role[] @relation("RolePermissions")
}

enum ActorType {
  user
  ai
  system
}

model AuditLog {
  id         String    @id @default(uuid())
  orgId      String
  org        Org       @relation(fields: [orgId], references: [id])
  actorType  ActorType @default(user)
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([orgId, createdAt])
}

// ---------- Integrações ----------
enum IntegrationStatus {
  disconnected
  connected
  error
}

enum HealthStatus {
  ok
  degraded
  down
}

model IntegrationAccount {
  id          String            @id @default(uuid())
  orgId       String
  org         Org               @relation(fields: [orgId], references: [id])
  key         String // clickup, gmail, instagram, whatsapp...
  label       String
  status      IntegrationStatus @default(disconnected)
  config      Json?
  connectedAt DateTime?
  createdAt   DateTime          @default(now())

  health IntegrationHealth?

  @@index([orgId])
}

model IntegrationHealth {
  id         String             @id @default(uuid())
  /// Sentinela + gatilho `IntegrationHealth_orgId_do_pai` (ver topo do arquivo).
  orgId      String             @default("")
  org        Org                @relation(fields: [orgId], references: [id])
  accountId  String             @unique
  account    IntegrationAccount @relation(fields: [accountId], references: [id])
  status     HealthStatus       @default(down)
  lastSyncAt DateTime?
  nextSyncAt DateTime?
  lastError  String?
  latencyMs  Int?
  checkedAt  DateTime           @default(now())

  @@index([orgId])
}

// ---------- Leads ----------
model LeadSource {
  id      String  @id @default(uuid())
  orgId   String
  org     Org     @relation(fields: [orgId], references: [id])
  key     String
  name    String
  channel String?
  leads   Lead[]

  @@unique([orgId, key])
}

enum LeadStatus {
  novo
  qualificado
  oportunidade
  reuniao
  proposta
  ganho
  perdido
}

model Lead {
  id          String      @id @default(uuid())
  orgId       String
  org         Org         @relation(fields: [orgId], references: [id])
  name        String
  email       String?
  phone       String?
  sourceId    String?
  source      LeadSource? @relation(fields: [sourceId], references: [id])
  campaignId  String?
  campaign    Campaign?   @relation(fields: [campaignId], references: [id])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  landingPage String?
  status      LeadStatus  @default(novo)
  ownerId     String?
  owner       User?       @relation("LeadOwner", fields: [ownerId], references: [id])
  nextAction  String?
  score       Int?
  anonymousId String?
  enteredAt   DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  events LeadEvent[]

  @@index([orgId, enteredAt])
  @@index([orgId, campaignId])
  @@index([anonymousId])
}

model LeadEvent {
  id         String   @id @default(uuid())
  /// Sentinela + gatilho `LeadEvent_orgId_do_pai` (ver topo do arquivo).
  orgId      String   @default("")
  org        Org      @relation(fields: [orgId], references: [id])
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  type       String
  payload    Json?
  occurredAt DateTime @default(now())

  @@index([leadId])
  @@index([orgId, occurredAt])
}

// ---------- Campanhas ----------
model Campaign {
  id        String    @id @default(uuid())
  orgId     String
  org       Org       @relation(fields: [orgId], references: [id])
  name      String
  objective String?
  channel   String?
  budget    Decimal?  @db.Decimal(12, 2)
  spend     Decimal?  @db.Decimal(12, 2)
  status    String    @default("ativa") // planejada|ativa|pausada|analise|encerrada|problema
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())

  leads Lead[]

  @@index([orgId])
}

// ---------- Pixel / eventos ----------
model PixelEvent {
  id          String   @id @default(uuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id])
  eventId     String   @unique
  sessionId   String
  anonymousId String
  eventName   String
  url         String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  device      String?
  value       Decimal? @db.Decimal(12, 2)
  metadata    Json?
  occurredAt  DateTime @default(now())

  @@index([orgId, occurredAt])
  @@index([sessionId])
}

// ---------- Tarefas (ClickUp/Asana unificadas) ----------
enum TaskStatus {
  aberta
  em_andamento
  concluida
  bloqueada
}

model Task {
  id          String     @id @default(uuid())
  orgId       String
  org         Org        @relation(fields: [orgId], references: [id])
  tool        String // clickup | asana | interno
  externalId  String?
  title       String
  description String?
  status      TaskStatus @default(aberta)
  priority    String?
  assignee    String?
  dueDate     DateTime?
  externalUrl String?
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([orgId, status, dueDate])
}

// ---------- Google (OAuth: Gmail/Agenda/Docs/Drive) ----------
// Uma conexão por org. Tokens PRÓPRIOS do root (isolado do escritório).
model GoogleAccount {
  id           String   @id @default(uuid())
  orgId        String   @unique
  org          Org      @relation(fields: [orgId], references: [id])
  email        String?
  accessToken  String
  refreshToken String?
  tokenType    String?
  scope        String?
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Meta / Instagram (OAuth: Facebook Login → Página → IG Business) ----------
// Uma conexão por org. Guarda o token de longa duração + a Página e a conta
// Instagram Business (métricas via Instagram Graph API). Isolado do escritório.
model MetaAccount {
  id          String   @id @default(uuid())
  orgId       String   @unique
  org         Org      @relation(fields: [orgId], references: [id])
  userToken   String // user access token de longa duração (~60d)
  pageId      String?
  pageName    String?
  pageToken   String? // page access token (consulta a Instagram Graph API)
  igUserId    String? // Instagram Business Account id
  igUsername  String?
  scope       String?
  expiresAt   DateTime
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Metas do projeto (sistema de métricas do LucasCreator) ----------
// Registrar SEMPRE o dado bruto; taxas são calculadas depois (histórico sobrevive
// a mudança de fórmula). Fonte: Instagram (Meta) onde dá + entrada manual.
model GoalConfig {
  id             String   @id @default(uuid())
  orgId          String   @unique
  org            Org      @relation(fields: [orgId], references: [id])
  challengeStart DateTime // dia 1 do desafio (365 dias)
  targetPosts    Int      @default(1000)
  targetViews    BigInt   @default(20000000)
  targetList     Int      @default(30000)
  targetSales    Int      @default(1000)
  updatedAt      DateTime @updatedAt
}

model GoalWeek {
  id             String    @id @default(uuid())
  orgId          String
  org            Org       @relation(fields: [orgId], references: [id])
  weekNumber     Int
  startDate      DateTime?
  posts          Int       @default(0)
  views          Int       @default(0)
  shares         Int       @default(0)
  saves          Int       @default(0)
  comments       Int       @default(0)
  profileVisits  Int       @default(0)
  newFollowers   Int       @default(0)
  totalFollowers Int       @default(0)
  nonFollowerPct Float     @default(0)
  storyViewers   Int       @default(0)
  storyReplies   Int       @default(0)
  listEntries    Int       @default(0)
  bioClicks      Int       @default(0)
  lives          Int       @default(0)
  storyDays      Int       @default(0)
  source         String    @default("manual") // manual | meta | mixed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([orgId, weekNumber])
  @@index([orgId, weekNumber])
}

// ---------- Base de conhecimento (Obsidian → embeddings/pgvector) ----------
model KnowledgeNote {
  id        String                       @id @default(uuid())
  orgId     String
  org       Org                          @relation(fields: [orgId], references: [id])
  path      String // caminho relativo à vault
  folder    String?
  title     String
  tags      String[]
  content   String // markdown (sem o frontmatter)
  links     String[] // wikilinks [[...]]
  wordCount Int                          @default(0)
  fileTime  DateTime // mtime do arquivo
  indexedAt DateTime                     @default(now())
  embedding Unsupported("vector(1536)")? // OpenAI text-embedding-3-small

  @@unique([orgId, path])
  @@index([orgId])
}

// ---------- Conteúdo (pipeline sincronizado do ClickUp — Gestão de Temas) ----------
// Preserva o status CRU do ClickUp (validar ideia/escrever roteiro/complete) e os
// campos personalizados (Formato/Eixo/Tipo/Fonte). ClickUp = fonte da verdade.
model ContentItem {
  id         String    @id @default(uuid())
  orgId      String
  org        Org       @relation(fields: [orgId], references: [id])
  source     String    @default("clickup")
  externalId String
  listId     String?
  listName   String?
  title      String
  status     String // status cru do ClickUp
  statusType String? // open | custom | closed
  formato    String?
  eixo       String?
  tipo       String?
  fonte      String?
  assignee   String?
  url        String?
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())

  @@index([orgId, status])
}

// ---------- Relatórios gerados por IA (resumo diário etc.) ----------
enum ReportType {
  daily
}

// Cada geração fica registrada (ponto zero: "não perder nada"): o texto do
// resumo, o snapshot dos números usados e QUAL modelo/provedor gerou.
model Report {
  id          String     @id @default(uuid())
  orgId       String
  org         Org        @relation(fields: [orgId], references: [id])
  type        ReportType @default(daily)
  title       String
  summary     String // texto gerado pela IA (markdown)
  data        Json // snapshot das métricas usadas no prompt
  provider    String // ex.: openai | anthropic
  model       String // ex.: gpt-4o
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime   @default(now())

  @@index([orgId, type, createdAt])
}

// ---------- Financeiro (FinOps: contas, lançamentos, categorias, bancos) ----------
// Módulo financeiro próprio do root. Integração bancária via Open Finance (Pluggy)
// e importação de extrato OFX. Base pronta p/ receber o enxerto do FinOps5.0.
enum FinanceAccountType {
  corrente
  poupanca
  caixa
  cartao
  investimento
}

enum FinanceTxType {
  entrada // receita / crédito
  saida // despesa / débito
}

enum FinanceTxStatus {
  previsto // conta a pagar/receber (ainda não realizada)
  realizado // efetivada (entrou/saiu do caixa)
  conciliado // batida com o extrato bancário
}

enum FinanceCategoryKind {
  receita
  despesa
}

enum BankConnectionStatus {
  pending
  connected
  error
  disconnected
}

// Conexão com um banco/instituição via Open Finance (Pluggy) ou upload de OFX.
model BankConnection {
  id              String               @id @default(uuid())
  orgId           String
  org             Org                  @relation(fields: [orgId], references: [id])
  provider        String               @default("pluggy") // pluggy | ofx
  externalId      String? // itemId no provedor (Pluggy)
  institutionName String?
  status          BankConnectionStatus @default(pending)
  lastSyncAt      DateTime?
  lastError       String?
  config          Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  accounts FinanceAccount[]

  @@index([orgId])
}

// Conta financeira (bancária, caixa, cartão). Saldo derivado dos lançamentos.
model FinanceAccount {
  id             String             @id @default(uuid())
  orgId          String
  org            Org                @relation(fields: [orgId], references: [id])
  name           String
  type           FinanceAccountType @default(corrente)
  institution    String?
  currency       String             @default("BRL")
  openingBalance Decimal            @default(0) @db.Decimal(14, 2)
  provider       String             @default("manual") // manual | pluggy | ofx
  externalId     String? // id da conta no provedor
  connectionId   String?
  connection     BankConnection?    @relation(fields: [connectionId], references: [id])
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  transactions FinanceTransaction[]
  contracts    Contract[]

  @@index([orgId])
  @@index([orgId, provider])
}

// Categoria de receita/despesa (plano de contas simples).
model FinanceCategory {
  id        String              @id @default(uuid())
  orgId     String
  org       Org                 @relation(fields: [orgId], references: [id])
  name      String
  kind      FinanceCategoryKind @default(despesa)
  color     String?
  createdAt DateTime            @default(now())

  transactions FinanceTransaction[]

  @@unique([orgId, kind, name])
  @@index([orgId])
}

// Lançamento financeiro. amount é SEMPRE positivo; o sinal vem de `type`.
// externalId (extrato/Pluggy) é único por conta p/ evitar duplicidade no sync.
model FinanceTransaction {
  id             String             @id @default(uuid())
  orgId          String
  org            Org                @relation(fields: [orgId], references: [id])
  accountId      String
  account        FinanceAccount     @relation(fields: [accountId], references: [id])
  categoryId     String?
  category       FinanceCategory?   @relation(fields: [categoryId], references: [id])
  type           FinanceTxType
  status         FinanceTxStatus    @default(realizado)
  description    String
  amount         Decimal            @db.Decimal(14, 2)
  date           DateTime // competência / data do lançamento
  dueDate        DateTime? // vencimento (contas a pagar/receber)
  paidAt         DateTime?
  counterparty   String? // favorecido / pagador
  documentNumber String?
  notes          String?
  source         String             @default("manual") // manual | ofx | pluggy
  externalId     String? // id no extrato/provedor (dedup)
  chartAccountId String? // conta do plano de contas (p/ DRE)
  chartAccount   ChartAccount?      @relation(fields: [chartAccountId], references: [id])
  // AP/AR (contas a pagar/receber): fornecedor/cliente, contrato, aprovação, rateio
  partnerId      String?
  partner        Partner?           @relation(fields: [partnerId], references: [id])
  contractId     String?
  contract       Contract?          @relation(fields: [contractId], references: [id])
  approvalStatus ApprovalStatus     @default(nao_requer)
  approvedById   String?
  approvedAt     DateTime?
  temRateio      Boolean            @default(false)
  // conciliação bancária: quando um movimento (ofx/pluggy) casa com um título
  matchScore     Float?
  matchType      String? // automatico | sugestao | manual
  reconciledAt   DateTime?
  departamentoId String?
  departamento   Departamento?      @relation(fields: [departamentoId], references: [id])
  projetoId      String?
  projeto        Projeto?           @relation(fields: [projetoId], references: [id])
  splits         TransactionSplit[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([orgId, accountId, externalId])
  @@index([orgId, date])
  @@index([orgId, status])
  @@index([orgId, approvalStatus])
  @@index([accountId])
  @@index([chartAccountId])
  @@index([partnerId])
}

// ---------- FinOps AP/AR: fornecedores/clientes, rateio, contratos, aprovação ----------
enum ApprovalStatus {
  nao_requer
  aguardando
  aprovado
  rejeitado
}

enum ContractStatus {
  ativo
  pausado
  encerrado
}

// Fornecedor/cliente unificado (fornecedores_clientes do FinOps).
model Partner {
  id           String   @id @default(uuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id])
  isCliente    Boolean  @default(false)
  isFornecedor Boolean  @default(false)
  razaoSocial  String
  nomeFantasia String?
  cnpjCpf      String?
  email        String?
  phone        String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions FinanceTransaction[]
  contracts    Contract[]

  @@index([orgId])
}

// Dimensões de rateio / corte do DRE.
model Departamento {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  splits       TransactionSplit[]
  transactions FinanceTransaction[]

  @@unique([orgId, nome])
}

model Projeto {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  splits       TransactionSplit[]
  transactions FinanceTransaction[]

  @@unique([orgId, nome])
}

// Contrato recorrente (pagar/receber) — gera lançamentos previstos.
model Contract {
  id                String          @id @default(uuid())
  orgId             String
  org               Org             @relation(fields: [orgId], references: [id])
  tipo              FinanceTxType // entrada = receber | saida = pagar
  partnerId         String?
  partner           Partner?        @relation(fields: [partnerId], references: [id])
  descricao         String
  valor             Decimal         @db.Decimal(14, 2)
  diaVencimento     Int             @default(1)
  periodicidade     String          @default("mensal") // mensal|bimestral|trimestral|semestral|anual
  chartAccountId    String?
  chartAccount      ChartAccount?   @relation(fields: [chartAccountId], references: [id])
  accountId         String?
  account           FinanceAccount? @relation(fields: [accountId], references: [id])
  dataInicio        DateTime
  dataFim           DateTime?
  proximoVencimento DateTime
  status            ContractStatus  @default(ativo)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  transactions FinanceTransaction[]

  @@index([orgId, status])
}

// Rateio de um lançamento (lancamento_rateios): divide o valor por conta/dep/projeto.
model TransactionSplit {
  id             String             @id @default(uuid())
  orgId          String
  org            Org                @relation(fields: [orgId], references: [id])
  transactionId  String
  transaction    FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  chartAccountId String?
  chartAccount   ChartAccount?      @relation(fields: [chartAccountId], references: [id])
  departamentoId String?
  departamento   Departamento?      @relation(fields: [departamentoId], references: [id])
  projetoId      String?
  projeto        Projeto?           @relation(fields: [projetoId], references: [id])
  percentual     Decimal?           @db.Decimal(5, 2)
  valor          Decimal            @db.Decimal(14, 2)

  @@index([transactionId])
}

// ---------- FinOps: Plano de Contas + DRE (enxerto do FinOps5.0) ----------
// Plano de contas gerencial hierárquico (nível 1 grupo → 2 subgrupo → 3 folha).
// Só folhas (permiteLancamento) recebem lançamento. Cada folha mapeia a uma linha
// do DRE (dreLine) — é o que o motor DRE usa p/ classificar receita/despesa.
model ChartAccount {
  id                String         @id @default(uuid())
  orgId             String
  org               Org            @relation(fields: [orgId], references: [id])
  parentId          String?
  parent            ChartAccount?  @relation("ChartTree", fields: [parentId], references: [id])
  children          ChartAccount[] @relation("ChartTree")
  codigo            String // ex.: "3.1.01"
  nome              String
  tipo              String // receita | despesa
  nivel             Int // 1 | 2 | 3
  permiteLancamento Boolean        @default(false)
  dreLineId         String?
  dreLine           DreLine?       @relation(fields: [dreLineId], references: [id])
  ativo             Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  transactions FinanceTransaction[]
  contracts    Contract[]
  splits       TransactionSplit[]

  @@unique([orgId, codigo])
  @@index([orgId, parentId])
}

// Linha do DRE (template dirigido por fórmula — o "Motor Vortex").
// tipo: origem (soma de lançamentos) | grupo/calculado (fórmula) | indicador (%).
// formula referencia outros códigos de linha (ex.: "MC / FL * 100").
model DreLine {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  codigo    String // FB, ISV, FL, CD, MC, EBITDA, RF, LL...
  nome      String
  operador  String   @default("( )") // (+) | (-) | (=) | (+/-) | ( )
  tipo      String   @default("origem") // origem | grupo | calculado | indicador
  formula   String?
  ordem     Int
  visivel   Boolean  @default(true)
  createdAt DateTime @default(now())

  chartAccounts ChartAccount[]

  @@unique([orgId, codigo])
  @@index([orgId, ordem])
}

// ---------- Bio (link na bio + desafio + rastreio first-party) ----------
// Absorvido do root-bio (app standalone aposentado). Rastreio próprio porque o
// analytics da bio precisa de sessionização e device/os/browser que o PixelEvent
// genérico não carrega; todo BioEvent também vira PixelEvent com o MESMO eventId
// (o @unique de lá faz o dedup nativo).

enum BioLinkTipo {
  url
  whatsapp
  email
}

enum BioPlataforma {
  instagram
  tiktok
}

// Como os posts chegam. "descoberta" (business_discovery) só existe no Instagram:
// o TikTok não tem equivalente — lá é conectado ou manual.
enum BioModoColeta {
  conectado
  descoberta
  manual
}

enum BioContaStatus {
  ok
  token_expirado
  conta_pessoal
  privada
  erro
}

model BioPage {
  id           String   @id @default(uuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id])
  handle       String   @unique
  titulo       String
  subtitulo    String?
  avatarUrl    String?
  tema         Json     @default("{}")
  publicada    Boolean  @default(false)
  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  links      BioLink[]
  challenges BioChallenge[]
  visits     BioVisit[]
  events     BioEvent[]

  @@index([orgId])
}

model BioLink {
  id       String      @id @default(uuid())
  /// Sentinela + gatilho `BioLink_orgId_do_pai` (ver topo do arquivo).
  orgId    String      @default("")
  org      Org         @relation(fields: [orgId], references: [id])
  pageId   String
  page     BioPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ordem    Int
  tipo     BioLinkTipo @default(url)
  rotulo   String
  destino  String
  icone    String?
  destaque Boolean     @default(false)
  ativo    Boolean     @default(true)
  criadoEm DateTime    @default(now())

  @@index([pageId, ordem])
  @@index([orgId])
}

model BioChallenge {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  pageId    String
  page      BioPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  titulo    String
  inicio    DateTime
  fim       DateTime
  metaPosts Int
  exibir    Boolean  @default(true)
  criadoEm  DateTime @default(now())

  contas BioChallengeAccount[]

  @@index([pageId])
  @@index([orgId, inicio])
}

model BioChallengeAccount {
  id            String         @id @default(uuid())
  /// Sentinela + gatilho `BioChallengeAccount_orgId_do_pai` (ver topo do arquivo).
  orgId         String         @default("")
  org           Org            @relation(fields: [orgId], references: [id])
  challengeId   String
  challenge     BioChallenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  plataforma    BioPlataforma
  handle        String
  modo          BioModoColeta  @default(manual)
  externalId    String?
  conexaoId     String?
  conexao       BioConexao?    @relation(fields: [conexaoId], references: [id], onDelete: SetNull)
  baselineCount Int            @default(0)
  baselineEm    DateTime?
  status        BioContaStatus @default(ok)
  ultimaColeta  DateTime?
  ultimoErro    String?

  posts     BioChallengePost[]
  snapshots BioChallengeSnapshot[]

  @@unique([challengeId, plataforma, handle])
  @@index([conexaoId])
  @@index([orgId])
}

// Uma linha por post. A contagem é COUNT nosso, não campo de terceiro:
// post deletado não zera o histórico em silêncio e a bio sobrevive à API fora do ar.
model BioChallengePost {
  id          String              @id @default(uuid())
  /// Sentinela + gatilho `BioChallengePost_orgId_do_pai` (ver topo do arquivo).
  orgId       String              @default("")
  org         Org                 @relation(fields: [orgId], references: [id])
  contaId     String
  conta       BioChallengeAccount @relation(fields: [contaId], references: [id], onDelete: Cascade)
  externalId  String
  publicadoEm DateTime
  permalink   String?
  tipo        String?
  vistoEm     DateTime            @default(now())
  sumiuEm     DateTime?

  @@unique([contaId, externalId])
  @@index([contaId, publicadoEm])
  @@index([orgId, publicadoEm])
}

// Append-only. Nunca sobrescrever: histórico tem que sobreviver a mudança de
// fórmula ou de fonte de coleta.
model BioChallengeSnapshot {
  id            String              @id @default(uuid())
  /// Sentinela + gatilho `BioChallengeSnapshot_orgId_do_pai` (ver topo do arquivo).
  orgId         String              @default("")
  org           Org                 @relation(fields: [orgId], references: [id])
  contaId       String
  conta         BioChallengeAccount @relation(fields: [contaId], references: [id], onDelete: Cascade)
  coletadoEm    DateTime            @default(now())
  totalCount    Int?
  countNaJanela Int?
  ok            Boolean             @default(true)
  erro          String?
  bruto         Json?

  @@index([contaId, coletadoEm])
  @@index([orgId, coletadoEm])
}

// Conta de plataforma autorizada por OAuth. Vive na org, não no desafio: conecta
// o Instagram uma vez e serve a qualquer desafio. Token cifrado (AES-256-GCM).
model BioConexao {
  id             String         @id @default(uuid())
  orgId          String
  org            Org            @relation(fields: [orgId], references: [id])
  plataforma     BioPlataforma
  externalId     String
  handle         String
  tokenCifrado   String
  refreshCifrado String?
  expiraEm       DateTime?
  escopos        String?
  status         BioContaStatus @default(ok)
  ultimoErro     String?
  conectadaEm    DateTime       @default(now())
  atualizadaEm   DateTime       @updatedAt

  contas BioChallengeAccount[]

  @@unique([orgId, plataforma, externalId])
  @@index([orgId])
}

// Credenciais do app de plataforma, preenchidas pela tela — não por arquivo na VPS.
// orgId null = credencial GLOBAL (exceção consciente à convenção orgId-scoped).
model BioCredencialApp {
  id             String        @id @default(uuid())
  plataforma     BioPlataforma
  orgId          String?
  org            Org?          @relation(fields: [orgId], references: [id])
  appId          String
  segredoCifrado String
  atualizadaEm   DateTime      @updatedAt
  atualizadaPor  String?

  @@index([plataforma, orgId])
}

// Guarda o `state` do OAuth por alguns minutos: impede costurar a autorização de
// uma conta na org de outra pessoa (CSRF). verifier = PKCE, exigido pelo TikTok.
model BioOauthState {
  id         String        @id @default(uuid())
  estado     String        @unique
  orgId      String
  org        Org           @relation(fields: [orgId], references: [id])
  plataforma BioPlataforma
  verifier   String?
  expiraEm   DateTime
  criadoEm   DateTime      @default(now())

  @@index([expiraEm])
}

// Identidade de cookie. Sem orgId de propósito: o mesmo browser pode visitar
// páginas de orgs diferentes (mesmo racional do PixelEvent.anonymousId).
// GLOBAL declarado em `src/common/modelos-globais.ts`. Os filhos (BioVisit,
// BioEvent) não dependem daqui para achar a empresa: carregam orgId próprio,
// vindo da BioPage.
model BioVisitor {
  id            String   @id
  primeiroVisto DateTime @default(now())
  ultimoVisto   DateTime @default(now())

  visits BioVisit[]
  events BioEvent[]
}

model BioVisit {
  id          String     @id @default(uuid())
  orgId       String
  org         Org        @relation(fields: [orgId], references: [id])
  visitorId   String
  visitor     BioVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  pageId      String
  page        BioPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  iniciadaEm  DateTime   @default(now())
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  ttclid      String?
  gclid       String?
  device      String?
  os          String?
  browser     String?
  pais        String?
  cidade      String?

  events BioEvent[]

  @@index([pageId, iniciadaEm])
  @@index([visitorId])
}

model BioEvent {
  id         String      @id @default(uuid())
  eventId    String      @unique
  orgId      String
  org        Org         @relation(fields: [orgId], references: [id])
  pageId     String
  page       BioPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  visitId    String?
  visit      BioVisit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitorId  String?
  visitor    BioVisitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  nome       String
  linkId     String?
  url        String?
  metadata   Json?
  ocorridoEm DateTime    @default(now())

  @@index([orgId, ocorridoEm])
  @@index([pageId, ocorridoEm])
  @@index([nome, ocorridoEm])
}

// ---------- Pauta (acervo de referência, radar e rodadas) ----------
// Ver docs/PAUTA.md. Onda 1: o ACERVO. Dois insumos com tempo de vida oposto —
// referência (repertório: como escrever, dura anos) e pauta (o assunto da semana,
// dura ~72h). A ficha abaixo é o schema de 14 campos já validado no vault
// Cerebro-Conteudo (427 roteiros classificados) — por isso é coluna, não Json.

enum PautaFonteTipo {
  rss
  perfil
  busca
  manual
}

enum PautaCapturaTipo {
  link
  print
  texto
}

enum PautaCapturaStatus {
  rascunho
  processando
  ficha
  descartada
  erro
}

// Taxonomia real do acervo (432 fichas classificadas em "9 - Engenharia Reversa
// das Referências"). As 4 primeiras são as campeãs do estudo (_ESTRUTURAS-CAMPEAS.md);
// as outras 4 existem no acervo e não podem ser perdidas na importação.
enum PautaFamilia {
  CUR // curiosidade / revelação
  REA // react / análise de terceiro
  STO // storytelling pessoal
  DEM // demonstração prática
  CON // contraste / comparação
  INT // interação com a audiência
  TRE // trend / meme
  ENC // encenação / esquete
  outra
}

enum PautaObjetivo {
  ALC // alcance
  AUT // autoridade
  VIN // vínculo
  VEN // venda
  ENG // engajamento
  PRO // prova social
  LEA // leads
}

// Onde a fonte é lida/monitorada. Não confundir com o canal de publicação.
model PautaFonte {
  id            String         @id @default(uuid())
  orgId         String
  org           Org            @relation(fields: [orgId], references: [id])
  tipo          PautaFonteTipo
  nome          String
  url           String? // feed RSS ou URL da busca
  handle        String? // @perfil, quando tipo = perfil
  plataforma    String? // instagram | tiktok | x | web
  ativo         Boolean        @default(true)
  intervaloMin  Int            @default(720)
  // Teto de gasto do Apify: sem isso um perfil vigiado queima crédito em silêncio.
  tetoRunsMes   Int            @default(30)
  runsNoMes     Int            @default(0)
  mesReferente  String? // "2026-08" — zera o contador na virada
  ultimaLeitura DateTime?
  ultimoErro    String?
  criadaEm      DateTime       @default(now())

  capturas PautaCaptura[]

  @@index([orgId, ativo])
}

// Caixa de entrada: o item CRU, antes de virar ficha. Barato e instantâneo —
// é o que resolve os prints que hoje morrem soltos numa pasta do Drive.
model PautaCaptura {
  id           String             @id @default(uuid())
  orgId        String
  org          Org                @relation(fields: [orgId], references: [id])
  fonteId      String?
  fonte        PautaFonte?        @relation(fields: [fonteId], references: [id], onDelete: SetNull)
  tipo         PautaCapturaTipo
  url          String?
  // Dedup: sha256 da URL normalizada (ou do conteúdo, quando não há URL).
  urlHash      String
  titulo       String?
  nota         String? // o que você quis guardar disso
  bruto        Json? // payload do Apify / HTML extraído / texto colado
  imagens      String[] // chaves no MinIO
  status       PautaCapturaStatus @default(rascunho)
  erro         String?
  apifyRunId   String?
  custoUsd     Decimal?           @db.Decimal(10, 4)
  capturadoEm  DateTime           @default(now())
  capturadoPor String?

  referencia PautaReferencia?

  @@unique([orgId, urlHash])
  @@index([orgId, status, capturadoEm])
}

// A ficha — schema do Cerebro-Conteudo. É o que entra no prompt de geração.
model PautaReferencia {
  id        String        @id @default(uuid())
  orgId     String
  org       Org           @relation(fields: [orgId], references: [id])
  capturaId String?       @unique
  captura   PautaCaptura? @relation(fields: [capturaId], references: [id], onDelete: SetNull)

  titulo      String
  plataforma  String?
  autor       String?
  url         String?
  publicadoEm DateTime?

  familia  PautaFamilia
  objetivo PautaObjetivo

  // Os 14 campos da ficha (`9 - Engenharia Reversa das Referências/fichas/`).
  materiaPrima     String
  tensaoCentral    String
  emocaoAlvo       String
  motorPsicologico String
  formulaHeadline  String
  estruturaCorpo   String
  prova            String
  cta              String?
  preRequisitos    String?
  antiPadroes      String?
  teoriaImplicita  String?

  metricas  Json? // likes/comments/views — formato varia por plataforma
  tags      String[]
  // Marcada à mão: só o que é campeão entra no prompt de geração.
  campea    Boolean  @default(false)
  // Proveniência: de onde veio quando importada do acervo legado.
  origem    String?  @default("manual")
  // Caminho do espelho .md no vault (null = ainda não espelhada).
  vaultPath String?

  embedding Unsupported("vector(1536)")?

  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  @@index([orgId, familia, objetivo])
  @@index([orgId, campea])
}

// ---------- Pauta: rotina, rodada e peças (ondas 2 e 3) ----------
// A rotina é o gatilho (cron); a rodada é a peça-mãe (curadoria de uma janela);
// as peças são os derivados por canal. Ver docs/PAUTA.md §4 e §7.

enum PautaRodadaStatus {
  coletando
  curada
  aprovada
  publicada
  falhou
}

enum PautaCanal {
  whatsapp
  instagram
  newsletter
  clickup
}

enum PautaPecaStatus {
  rascunho
  aprovada
  publicada
  descartada
}

model PautaRotina {
  id     String  @id @default(uuid())
  orgId  String
  org    Org     @relation(fields: [orgId], references: [id])
  slug   String
  nome   String
  // Cron de 5 campos (min hora dia mês diaDaSemana). Avaliado a cada minuto
  // contra o fuso `tz` — ver pauta-scheduler.service.ts.
  cron   String
  tz     String  @default("America/Sao_Paulo")
  ativo  Boolean @default(true)
  // Janela de coleta e instruções de pauta (assunto, tom, quantos itens).
  config Json    @default("{}")

  ultimoRun    DateTime?
  ultimoStatus String?
  proximoRun   DateTime?
  criadaEm     DateTime  @default(now())

  rodadas PautaRodada[]

  @@unique([orgId, slug])
  @@index([orgId, ativo])
}

// A peça-mãe: uma execução da rotina. Guarda o que entrou (itens), o que saiu
// (corpo) e quem gerou (provider/model/custo) — mesmo contrato do Report.
model PautaRodada {
  id       String            @id @default(uuid())
  orgId    String
  org      Org               @relation(fields: [orgId], references: [id])
  rotinaId String?
  rotina   PautaRotina?      @relation(fields: [rotinaId], references: [id], onDelete: SetNull)
  status   PautaRodadaStatus @default(coletando)
  titulo   String

  janelaIni    DateTime
  janelaFim    DateTime
  // O que a IA selecionou, com fonte e URL de cada item (procedência).
  itens        Json     @default("[]")
  // Quais fichas campeãs entraram no prompt (auditoria do repertório usado).
  fichasUsadas String[]
  corpo        String   @default("")

  provider String?
  model    String?
  custoUsd Decimal? @db.Decimal(10, 4)
  erro     String?

  criadaEm DateTime @default(now())

  pecas PautaPeca[]

  @@index([orgId, status, criadaEm])
}

model PautaPeca {
  id       String          @id @default(uuid())
  orgId    String
  org      Org             @relation(fields: [orgId], references: [id])
  rodadaId String
  rodada   PautaRodada     @relation(fields: [rodadaId], references: [id], onDelete: Cascade)
  canal    PautaCanal
  formato  String // texto | carrossel | reels | email | tema
  titulo   String
  corpo    String
  // Slides do carrossel, JID do grupo, id do tema no ClickUp…
  meta     Json            @default("{}")
  status   PautaPecaStatus @default(rascunho)

  // Link rastreado: o clique volta como BioEvent/PixelEvent e alimenta Metas.
  bioLinkId    String?
  externalId   String?
  publicadaEm  DateTime?
  publicadaPor String?
  erro         String?

  criadaEm DateTime @default(now())

  @@index([orgId, status])
  @@index([rodadaId])
}

// ---------- Trabalho (gestão de tarefas estilo ClickUp, nativa do mkt-os) ----------
// Réplica de usabilidade do espaço `root` do ClickUp (fotografia 25/07/2026):
// pastas → listas → tarefas; statuses configuráveis POR LISTA (pipeline com cor e
// tipo open/custom/closed), campos personalizados com opções, etiquetas do espaço,
// comentários e prioridade. externalId preserva o id do ClickUp p/ reconciliação.

enum WorkStatusType {
  open
  custom
  closed
}

enum WorkPriority {
  urgente
  alta
  normal
  baixa
}

enum WorkFieldType {
  drop_down
  texto
  numero
  data
  checkbox
  url
}

model WorkFolder {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists WorkList[]

  @@unique([orgId, name])
}

model WorkList {
  id         String      @id @default(uuid())
  orgId      String
  org        Org         @relation(fields: [orgId], references: [id])
  folderId   String?
  folder     WorkFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name       String
  order      Int         @default(0)
  externalId String? // id da lista no ClickUp (ex.: Gestão de Temas = 901327640001)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  statuses WorkStatus[]
  fields   WorkField[]
  tasks    WorkTask[]

  @@index([orgId, folderId])
}

model WorkStatus {
  id     String         @id @default(uuid())
  /// Sentinela + gatilho `WorkStatus_orgId_do_pai` (ver topo do arquivo).
  orgId  String         @default("")
  org    Org            @relation(fields: [orgId], references: [id])
  listId String
  list   WorkList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  name   String
  type   WorkStatusType @default(open)
  color  String         @default("#87909e")
  order  Int            @default(0)

  tasks WorkTask[]

  @@unique([listId, name])
  @@index([orgId])
}

model WorkTag {
  id    String @id @default(uuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  name  String
  color String @default("#5f55ee")

  tasks WorkTask[] @relation("WorkTaskTags")

  @@unique([orgId, name])
}

// Campo personalizado. listId nulo = vale para o espaço todo.
model WorkField {
  id     String        @id @default(uuid())
  orgId  String
  org    Org           @relation(fields: [orgId], references: [id])
  listId String?
  list   WorkList?     @relation(fields: [listId], references: [id], onDelete: Cascade)
  name   String
  type   WorkFieldType @default(drop_down)
  order  Int           @default(0)

  options WorkFieldOption[]
  values  WorkFieldValue[]

  @@index([orgId, listId])
}

model WorkFieldOption {
  id      String    @id @default(uuid())
  /// Sentinela + gatilho `WorkFieldOption_orgId_do_pai` (ver topo do arquivo).
  orgId   String    @default("")
  org     Org       @relation(fields: [orgId], references: [id])
  fieldId String
  field   WorkField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  name    String
  color   String    @default("#87909e")
  order   Int       @default(0)

  values WorkFieldValue[]

  @@unique([fieldId, name])
  @@index([orgId])
}

model WorkTask {
  id          String       @id @default(uuid())
  orgId       String
  org         Org          @relation(fields: [orgId], references: [id])
  listId      String
  list        WorkList     @relation(fields: [listId], references: [id])
  statusId    String
  status      WorkStatus   @relation(fields: [statusId], references: [id])
  title       String
  description String?
  priority    WorkPriority @default(normal)
  assignee    String?
  dueDate     DateTime?
  startDate   DateTime?
  parentId    String?
  parent      WorkTask?    @relation("WorkSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks    WorkTask[]   @relation("WorkSubtasks")
  externalId  String? // id da task no ClickUp (fotografia); reconciliação futura
  externalUrl String?
  archived    Boolean      @default(false)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tags     WorkTag[]        @relation("WorkTaskTags")
  values   WorkFieldValue[]
  comments WorkComment[]

  @@unique([orgId, externalId])
  @@index([orgId, listId, statusId])
  @@index([orgId, archived, dueDate])
}

/// Dois pais obrigatórios (WorkTask e WorkField). Aqui o gatilho é DOIS: o
/// primeiro deriva o orgId da tarefa, o segundo confere contra o do campo — é
/// assim que "os dois pais são da mesma empresa" vira garantia do banco.
model WorkFieldValue {
  id       String           @id @default(uuid())
  /// Sentinela + gatilhos `WorkFieldValue_orgId_*` (ver topo do arquivo).
  orgId    String           @default("")
  org      Org              @relation(fields: [orgId], references: [id])
  taskId   String
  task     WorkTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fieldId  String
  field    WorkField        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  optionId String?
  option   WorkFieldOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String? // tipos não-dropdown (texto/número/data/checkbox/url)

  @@unique([taskId, fieldId])
  @@index([orgId])
}

model WorkComment {
  id         String   @id @default(uuid())
  /// Sentinela + gatilho `WorkComment_orgId_do_pai` (ver topo do arquivo).
  orgId      String   @default("")
  org        Org      @relation(fields: [orgId], references: [id])
  taskId     String
  task       WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([orgId, createdAt])
}

// ============================================================================
// Régua, porta e rastro — a escada R0-R5 saindo do papel.
//
// O motor de decisão é @mktos/policy, puro e sem I/O, cópia byte a byte do
// anexo normativo. O que mora aqui é a CASCA: o catálogo como dado, a política
// versionada por empresa, e o registro do que a porta decidiu e executou.
// ============================================================================

enum RiskLevel {
  R0
  R1
  R2
  R3
  R4
  R5
}

enum Alcada {
  operador
  responsavel
  titular
}

/// Catálogo de capacidades. GLOBAL, sem orgId de propósito: a diferença entre
/// empresas mora no PolicyVersion, não numa cópia do catálogo por tenant —
/// duplicar 60 linhas por cliente é garantir que um dia divergem.
/// Declarado em `src/common/modelos-globais.ts`.
model Capability {
  id           String    @id // id pontuado do documento: "whatsapp.mensagem.enviar"
  descricao    String
  level        RiskLevel
  /// Objeto Efeito de @mktos/policy. É ELE que a régua classifica — o `level`
  /// acima é a declaração, e o teste reprova quando os dois divergem.
  efeito       Json
  /// Chaves que entram no canonicalHash da aprovação. Vazio = o corpo inteiro
  /// entra (falha fechada: capacidade que esqueceu de declarar prende a
  /// aprovação a tudo, o que é estrito, não frouxo).
  hashKeys     String[]
  /// JSON Schema dos argumentos, para o gateway validar antes de classificar.
  argsSchema   Json?
  /// Nome como o modelo enxerga. A API de tool-calling só aceita [A-Za-z0-9_-],
  /// então nunca é o id pontuado. Nulo = nenhum agente alcança.
  ferramenta   String?   @unique
  /// `MÉTODO /caminho` que implementa. Nulo = declarada e não implementada.
  rota         String?
  desfazer     String?
  /// Módulo que traz a capacidade — desligou o módulo, sai do alcance.
  moduloKey    String?
  isBuiltin    Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  decisoes  PolicyDecision[]
  toolCalls ToolCall[]

  @@index([moduloKey])
  @@index([level])
}

/// Política em vigor. orgId NULO = a base ROOT que todas herdam.
model PolicyVersion {
  id        String    @id @default(uuid())
  orgId     String?
  org       Org?      @relation(fields: [orgId], references: [id])
  versao    Int
  /// Documento RESOLVIDO (base + delta aplicado) — é o que o serviço carrega.
  documento Json
  /// Só o que esta empresa sobrescreveu. Nulo na base.
  delta     Json?
  /// DOIS diffs, com a REFERÊNCIA no nome — `DiffDePolitica` de @mktos/policy:
  /// capacidade por capacidade (`de`, `para`, `direcao`, `campos`, `travas`),
  /// limite por limite e seção por seção (RF-P-04, "com data e responsável").
  ///
  /// São dois porque são duas perguntas, e uma coluna só chamada `diff` fazia
  /// três escritores gravarem referências diferentes nela: a sobrescrita
  /// gravava contra a base, a reaplicação contra a versão anterior da empresa
  /// e o seed da base contra a versão anterior da base. Quem lesse numa tela
  /// compararia coisas diferentes sem saber.
  ///
  /// `diffDaBase` — o que ESTA EMPRESA tem de diferente da base herdada da
  /// ROOT. Nulo na versão da própria base (orgId nulo), onde a pergunta não
  /// existe.
  diffDaBase Json?
  /// `diffDaVersaoAnterior` — o que ESTA VERSÃO mudou em relação à anterior do
  /// MESMO escopo (a base anterior, ou a versão anterior desta empresa). É o
  /// diff honesto sobre a direção: uma queda de R4 para R3 aparece aqui como
  /// `desce`, enquanto contra a base (que é R2) ela é `sobe`. Nulo na primeira
  /// versão, que não tem anterior.
  ///
  /// Gravados, e não recalculados na leitura, de propósito: a base muda. Seis
  /// meses depois, recalcular contra a base de hoje responderia outra pergunta
  /// — e a que o histórico precisa responder é "o que esta pessoa mudou,
  /// quando mudou".
  diffDaVersaoAnterior Json?
  /// Obrigatório quando um nível DESCE ou a aprovação de R2 é desligada:
  /// "descer nível nunca é automático" é invariante da escada. Quem cobra é
  /// `recusasDaSobrescrita()` em @mktos/policy, chamada pelo PolicyService.
  motivo    String
  /// O responsável do RF-P-06. `String?` e não relação com User porque a base
  /// ROOT (orgId nulo) é semeada por script, sem usuário nenhum logado — e uma
  /// FK obrigatória ali tornaria o seed impossível. Sobrescrita de empresa SEM
  /// este campo é recusada quando afrouxa alguma coisa; é a trava, não a coluna.
  autorId   String?
  ativaDe   DateTime  @default(now())
  ativaAte  DateTime?
  criadoEm  DateTime  @default(now())

  decisoes PolicyDecision[]

  @@unique([orgId, versao])
  @@index([orgId, ativaDe])
}

/// O que a régua decidiu, por chamada. Existe separado do ToolCall porque a
/// RECUSA também é uma decisão registrada — e é o número que a tela da Régua
/// mostra em "N em 30 dias".
model PolicyDecision {
  id              String         @id @default(uuid())
  orgId           String
  org             Org            @relation(fields: [orgId], references: [id])
  capabilityId    String?
  capability      Capability?    @relation(fields: [capabilityId], references: [id])
  policyVersionId String?
  policyVersion   PolicyVersion? @relation(fields: [policyVersionId], references: [id])

  nivelBase      RiskLevel
  nivel          RiskLevel
  permitido      Boolean
  exigeAprovacao Boolean
  sinais         String[]
  motivo         String
  /// Com que porta esta linha foi escrita: `impor` ou `observar`. O modo NÃO
  /// altera o fluxo — desde 10/09/2026 observar bloqueia R5 e retém o que exige
  /// aprovação exatamente como impor (ver `gateway/tool-gateway.service.ts`).
  /// O que observar afrouxa é o CARIMBO do registro, e é por esta coluna que o
  /// relatório de calibragem separa as decisões tomadas em cada modo antes de
  /// alguém virar a chave (`src/scripts/relatorio-observar.ts`).
  modo           String    @default("impor")
  criadoEm       DateTime  @default(now())

  @@index([orgId, criadoEm])
  @@index([orgId, nivel])
}

enum ToolCallStatus {
  executado
  aguardando_aprovacao
  recusado
  erro
}

/// Uma passagem pela porta. É daqui que sai "usada por · agente · N chamadas".
model ToolCall {
  id            String         @id @default(uuid())
  orgId         String
  org           Org            @relation(fields: [orgId], references: [id])
  capabilityId  String?
  capability    Capability?    @relation(fields: [capabilityId], references: [id])
  decisionId    String?
  sessionId     String?
  agentSlug     String?
  actorType     ActorType      @default(ai)
  actorId       String?
  status        ToolCallStatus
  /// Argumentos já validados e normalizados. Redigidos conforme a
  /// sensibilidade da capacidade — segredo nunca entra cru.
  args          Json?
  resultado     Json?
  erro          String?
  nivel         RiskLevel?
  approvalId    String?
  duracaoMs     Int            @default(0)
  correlationId String?
  criadoEm      DateTime       @default(now())

  @@index([orgId, criadoEm])
  @@index([orgId, capabilityId, criadoEm])
  @@index([correlationId])
  @@index([agentSlug, criadoEm])
}

enum ApprovalState {
  pendente
  confirmada
  consumida
  rejeitada
  expirada
}

/// A fila de aprovação. Saiu do Map em memória: no Map o uso único era seguro
/// por acidente (um processo, JS single-threaded); em tabela, duas requisições
/// simultâneas consumiriam o mesmo token e a mensagem sairia duas vezes. Quem
/// impede é o updateMany condicional em ApprovalsService.consumeForWrite.
model Approval {
  id              String        @id @default(uuid())
  orgId           String
  org             Org           @relation(fields: [orgId], references: [id])
  decisionId      String?
  toolCallId      String?
  capabilityId    String?
  /// Invariante 7 da escada: quem aprova nunca é quem propôs.
  propostoPorId   String
  propostoPorTipo ActorType     @default(ai)
  resourceType    String
  resourceId      String
  /// canonicalHash sobre as hashKeys da capacidade — o bind ao conteúdo exato.
  contentHash     String
  resumo          String
  status          ApprovalState @default(pendente)
  nivelExigido    RiskLevel     @default(R3)
  alcadaMinima    Alcada        @default(operador)
  exigeReauth     Boolean       @default(false)
  motivo          String?
  canal           String?
  /// sha256 do token. O token cru é devolvido UMA vez e nunca persistido.
  tokenHash       String        @unique
  aprovadoPorId   String?
  aprovadoEm      DateTime?
  reautenticadoEm DateTime?
  consumidoEm     DateTime?
  expiraEm        DateTime
  criadoEm        DateTime      @default(now())

  @@index([orgId, status, expiraEm])
  @@index([orgId, criadoEm])
}

/// RASTRO append-only e encadeado por hash.
///
/// O AuditLog continua existindo e continua sendo escrito — este modelo NÃO o
/// substitui nesta rodada. A diferença é que aqui o registro é PRÉ-CONDIÇÃO de
/// execução: a porta grava, faz commit, e só então executa o efeito.
///
/// Append-only de verdade só vale quando a aplicação parar de conectar como
/// dona das tabelas. Até lá as RULEs da migration derrotam um update acidental,
/// mas a garantia é convenção — e a tela do Rastro diz isso.
model EventLog {
  id            String     @id @default(uuid())
  orgId         String
  org           Org        @relation(fields: [orgId], references: [id])
  /// Sequência por empresa, serializada por advisory lock.
  seq           BigInt
  tipo          String
  actorType     ActorType  @default(ai)
  actorId       String?
  agentSlug     String?
  capabilityId  String?
  toolCallId    String?
  decisionId    String?
  nivel         RiskLevel?
  correlationId String?
  payload       Json?
  contentHash   String?
  prevHash      String?
  hash          String
  retencaoAte   DateTime
  ocorreuEm     DateTime   @default(now())

  @@unique([orgId, seq])
  @@index([orgId, ocorreuEm])
  @@index([orgId, tipo])
  @@index([correlationId])
}

// ============================================================================
// Tripulação — os agentes, os procedimentos e o traço de cada sessão.
//
// Um agente, um trabalho (RF-N-01). Começa SEM permissão nenhuma e recebe
// capacidade nomeada: capacidade fora da declaração é recusada pela porta.
// ============================================================================

enum AgentEstado {
  rodando
  aprendendo
  planejado
  pausado
}

enum AgentTipo {
  /// Chama modelo, propõe ferramenta, tem SOP. É agente no sentido do produto.
  llm
  /// Sincroniza um conector. Não chama modelo e não tem custo de token — mas
  /// tem dono, missão e execução registrada, que é o que a tela precisa.
  conector
}

model Agent {
  id       String  @id @default(uuid())
  orgId    String
  org      Org     @relation(fields: [orgId], references: [id])
  slug     String
  nome     String
  iniciais String  @default("")
  missao   String
  pilar    String?
  donoId   String?
  dono     User?   @relation("AgentDono", fields: [donoId], references: [id])

  tipo   AgentTipo   @default(llm)
  estado AgentEstado @default(planejado)

  /// RF-N-03: as ferramentas que ele declarou. Fora desta lista, a porta recusa.
  capacidades  String[]
  /// Até onde ele vai sozinho. A porta é quem impõe; isto é o teto declarado.
  autonomiaAte RiskLevel @default(R0)
  /// RF-N-07: agente que erra tem a autonomia rebaixada por 24h.
  rebaixadoAte DateTime?
  rebaixadoPor String?

  modelo       String?
  effort       String   @default("high")
  maxPassos    Int      @default(8)
  tetoCustoUsd Decimal  @default(0.50) @db.Decimal(10, 4)
  tetoSegundos Int      @default(180)
  /// As regras da casa DESTE agente — o ContextItem do PRD em versão mínima.
  contextoFixo String[]

  cron  String?
  tz    String  @default("America/Sao_Paulo")
  ativo Boolean @default(true)

  /// RF-N-05. É a linha de base DECLARADA por uma pessoa: quantos minutos
  /// alguém gastava nisso por execução. Zero = ninguém informou ainda, e a
  /// tela mostra "—", nunca um número inventado.
  minutosPorExecucao Int       @default(0)
  baselinePorId      String?
  baselineEm         DateTime?
  execucoes          Int       @default(0)
  falhas             Int       @default(0)

  ultimaExecucaoEm  DateTime?
  ultimoStatus      String?
  proximaExecucaoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sop      Sop?
  sessions Session[]

  @@unique([orgId, slug])
  @@index([orgId, estado])
  @@index([ativo, cron])
}

/// RF-N-02: formato fixo. A ESCALAÇÃO e as regras da casa NÃO moram aqui —
/// são constantes do código (src/agents/sop.ts). Guardar em banco seria
/// convidar a editar, e o requisito diz que o texto não é editável.
model Sop {
  id      String @id @default(uuid())
  orgId   String
  agentId String @unique
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  proposito         String
  gatilho           String
  passos            String[]
  definicaoDePronto String
  observacoes       String?

  versao        Int      @default(1)
  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt
  criadoEm      DateTime @default(now())
}

enum SessionCanal {
  web
  whatsapp
  telegram
  terminal
  rotina
  mcp
}

enum SessionStatus {
  rodando
  respondida
  executada
  retida
  recusada
  falhou
}

/// Uma troca com a central, do pedido ao registro. É o que a tela de Sessões
/// mostra — e o que não existia: o sistema registrava decisões, não conversas.
model Session {
  id      String @id @default(uuid())
  orgId   String
  org     Org    @relation(fields: [orgId], references: [id])
  agentId String
  /// SEM onDelete: Cascade. Agente sai de circulação com estado 'pausado',
  /// nunca com DELETE — apagar o agente apagaria o histórico dele.
  agent   Agent  @relation(fields: [agentId], references: [id])

  canal             SessionCanal
  canalRef          String?
  solicitanteId     String?
  solicitanteRotulo String

  pedido   String
  resposta String @default("")

  status   SessionStatus @default(rodando)
  nivelMax RiskLevel?
  motivo   String?

  fontes         Json    @default("[]")
  /// A resposta trouxe número sem citar fonte. Não bloqueia — sinaliza, e é
  /// o KPI "sem procedência" da tela.
  semProcedencia Boolean @default(false)

  custoUsd      Decimal @default(0) @db.Decimal(10, 6)
  /// false = o modelo servido está fora da tabela de preço. A tela mostra
  /// "não medido", nunca R$ 0,00.
  custoEstimado Boolean @default(true)
  provider      String?
  modelo        String?
  tokensIn      Int     @default(0)
  tokensOut     Int     @default(0)
  passos        Int     @default(0)
  duracaoMs     Int     @default(0)

  ultimaAtividadeEm DateTime  @default(now())
  encerradaEm       DateTime?
  criadaEm          DateTime  @default(now())

  steps SessionStep[]

  @@index([orgId, criadaEm])
  @@index([orgId, canal, criadaEm])
  @@index([orgId, agentId, criadaEm])
  @@index([orgId, status])
  /// Retomada: a sessão viva daquele canal e daquele contato.
  @@index([orgId, canal, canalRef, ultimaAtividadeEm])
}

enum SessionStepTipo {
  pedido
  contexto
  modelo
  ferramenta
  aprovacao
  resultado
  erro
}

/// Os 6 blocos do traço saem daqui. Nenhum é campo: todos são reconstruídos
/// dos passos, que é o que permite a tela mostrar a sessão como ela aconteceu.
model SessionStep {
  id        String          @id @default(uuid())
  orgId     String
  sessionId String
  session   Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ordem     Int
  tipo      SessionStepTipo

  // bloco 03 — as ferramentas chamadas
  capacidade      String?
  /// "trimestre 3 · 2026" — é o que a tela mostra, não o JSON cru.
  argsResumo      String?
  args            Json?
  resultadoResumo String?
  toolCallId      String?

  // bloco 04 — a régua decidiu. A porta preenche; o runtime só copia.
  nivel      RiskLevel?
  decisao    String?
  motivo     String?
  gatilhos   String[]
  approvalId String?

  // o custo mora no passo, e a sessão soma
  provider         String?
  modelo           String?
  tokensIn         Int?
  tokensOut        Int?
  tokensCacheRead  Int?
  tokensCacheWrite Int?
  custoUsd         Decimal? @db.Decimal(10, 6)
  custoEstimado    Boolean  @default(true)
  stopReason       String?

  fontes  Json    @default("[]")
  /// Blocos crus do provider. Permite retomar sem perder o thinking — remover
  /// ou reordenar quebra a assinatura e a API recusa o turno seguinte.
  payload Json?
  texto   String?
  erro    String?

  duracaoMs Int      @default(0)
  criadoEm  DateTime @default(now())

  @@unique([sessionId, ordem])
  @@index([sessionId, ordem])
  @@index([orgId, criadoEm])
}

/// Quem é a pessoa do outro lado do canal.
///
/// Sem isto o "quem aprova é gente" não existe de verdade: hoje quem clica no
/// botão do Telegram é um chat_id anônimo, e a API grava a confirmação com o
/// ator da CONTA DE SERVIÇO do bot. É correção de rastro, não enfeite.
model ChannelIdentity {
  id         String       @id @default(uuid())
  orgId      String
  org        Org          @relation(fields: [orgId], references: [id])
  canal      SessionCanal
  externalId String
  userId     String?
  user       User?        @relation(fields: [userId], references: [id])
  rotulo     String
  ativo      Boolean      @default(true)
  criadoEm   DateTime     @default(now())

  @@unique([orgId, canal, externalId])
  @@index([orgId, canal])
}

// ===========================================================================
// FATIA 3.7 — DESLIGAR UM CONECTOR, POR EMPRESA (RF-G-06)
// ===========================================================================

/// Um conector desligado para uma empresa. A LINHA EXISTIR **É** O
/// DESLIGAMENTO — não há coluna de estado, e religar é apagar a linha.
///
/// POR QUE APAGAR EM VEZ DE MARCAR `religadoEm`. Um par (empresa, conector) pode
/// ser desligado e religado muitas vezes; guardar o histórico aqui exigiria
/// índice único parcial (`WHERE "religadoEm" IS NULL`), que o Prisma não sabe
/// declarar — o schema passaria a mentir sobre o banco no primeiro `db:diff`. E
/// o histórico não precisa morar aqui: cada desligamento e cada religamento
/// grava evento no RASTRO, que é append-only e é onde "quem, quando e por quê"
/// pertence.
///
/// O QUE ESTA TABELA **NÃO** GUARDA: credencial. Desligar não toca em
/// `GoogleAccount`, `MetaAccount`, `IntegrationAccount.status` nem `config` —
/// religar restabelece o uso sem nova autorização, e é isso que a suíte cobra.
model ConectorDesligado {
  id    String @id @default(uuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  /// Chave do conector em `CONNECTORS` (`packages/shared/src/schemas.ts`):
  /// gmail, gcal, gdocs, drive, clickup, instagram, whatsapp, obsidian...
  /// Grupo (`google`) é conveniência de ENTRADA e vira uma linha por chave —
  /// ver `GRUPOS_DE_CONECTOR` em `src/integrations/conectores.ts`.
  conector String

  /// O que a pessoa escreveu ao desligar. Entra na frase da recusa.
  motivo       String?
  desligadoPor String?
  desligadoEm  DateTime @default(now())

  @@unique([orgId, conector])
  @@index([orgId])
}

// ============================================================================
// FATIA 3.5 — RETENÇÃO DO RASTRO POR EMPRESA (RF-R-06)
//
// Até aqui a retenção era UMA variável de ambiente (`RASTRO_RETENCAO_DIAS`,
// fixa em 1825 no docker-compose), global para a instância inteira. Isso é
// errado nos dois sentidos: o cliente que precisa guardar mais não consegue, e
// o que precisa guardar menos (minimização, LGPD art. 16) também não.
//
// A ausência de linha aqui NÃO é "sem retenção": é "herda o padrão", que sai de
// `retencao.rastroDias` da política (1825, justificado pelo prazo decadencial do
// CTN art. 173) e cai na variável de ambiente só se a política não disser. Por
// isso a tabela nasce VAZIA e continua vazia para quem não configurou nada —
// materializar o padrão em linha congelaria o valor herdado no dia do
// provisionamento, e a próxima mudança da política não alcançaria mais ninguém.
//
// `motivo` é obrigatório NA REGRA DE NEGÓCIO (não no banco) quando o prazo fica
// ABAIXO do herdado: encurtar o rastro é a única direção que apaga prova, e
// apagar prova sem motivo escrito é o que 02-CONSTRAINTS não admite. Quem cobra
// é `RetencaoService.definir`.
// ============================================================================

model RastroRetencao {
  id    String @id @default(uuid())
  orgId String @unique
  org   Org    @relation(fields: [orgId], references: [id])

  /// Dias de guarda do RASTRO desta empresa. Vira `EventLog.retencaoAte` na
  /// gravação de cada evento — não é aplicado retroativamente de propósito: o
  /// prazo que vale para uma linha é o que valia quando ela foi escrita.
  dias Int

  /// Por que esta empresa difere do padrão herdado. Exigido ao encurtar.
  motivo      String?
  /// Quem decidiu. É pessoa, nunca agente (mesma regra do aprovador).
  definidoPor String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ===========================================================================
// FATIA 3.6 — TETO DE CUSTO DE IA POR EMPRESA E POR DIA (RF-G-05, RNF-05)
//
// Acrescentado no FIM do arquivo de propósito: três fatias da onda 6 criam
// tabela ao mesmo tempo, e reescrever o arquivo apagaria o trabalho das outras
// duas (protocolo da onda, seção 4).
//
// JÁ EXISTIA, E NÃO FOI REESCRITO: `Agent.tetoCustoUsd` (teto por AGENTE e por
// EXECUÇÃO, imposto no laço de `agents/agent-runtime.service.ts`) e o custo
// REAL de cada passo, que o provedor devolve e o `SessionStep` grava. Este é o
// TERCEIRO nível: o da empresa, somado no dia, e ele vale para toda chamada de
// modelo — inclusive as que não nascem de sessão de agente (relatório,
// curadoria, pauta), que não têm passo em `SessionStep` nenhum.
// ===========================================================================

/// O teto que a EMPRESA declarou para gasto com modelo de IA em um dia.
///
/// Uma linha por empresa. Empresa sem linha aqui é empresa SEM TETO: nada é
/// cortado e nada é contado. É o estado de quem nunca configurou, e é o único
/// estado em que o corte não existe — por isso `ativo` é um campo separado do
/// valor: desligar o teto é uma decisão que fica REGISTRADA (com quem e
/// quando), enquanto apagar a linha não deixa rastro nenhum.
///
/// POR QUE O FUSO MORA AQUI, E NÃO NO AGENTE
/// "Por dia" só quer dizer alguma coisa depois de escolher de quem é o dia. O
/// agente já carrega `tz`, e usá-lo seria o erro: uma mesma empresa com dois
/// agentes em fusos diferentes teria DOIS dias abertos ao mesmo tempo, e a
/// soma do teto deixaria de ser uma soma — cada agente poderia gastar o teto
/// inteiro dentro da sua própria virada. O fuso do SERVIDOR (UTC, no container)
/// seria pior de outro jeito: viraria o dia às 21h de Brasília, no meio do
/// expediente, e o cliente veria o corte chegar em hora que não é meia-noite
/// nenhuma para ele. O teto é orçamento da EMPRESA, então o dia é o dela.
model TetoDeCustoIa {
  id    String @id @default(uuid())
  orgId String @unique
  org   Org    @relation(fields: [orgId], references: [id])

  /// Em dólar, que é a moeda em que o provedor cobra e em que `preco.ts`
  /// calcula. Converter para real aqui seria gravar uma cotação que envelhece.
  tetoDiarioUsd Decimal @db.Decimal(12, 6)

  /// Nome IANA (`America/Sao_Paulo`). Fuso inválido NÃO derruba a chamada de
  /// modelo: o serviço cai no padrão e registra o aviso — cortar por causa de
  /// uma string de configuração errada seria trocar um problema por outro.
  fusoHorario String @default("America/Sao_Paulo")

  /// Desligado, o teto não corta e o consumo do dia CONTINUA sendo somado. É o
  /// modo de observação que permite calibrar o valor antes de impor.
  ativo Boolean @default(true)

  /// Quem decidiu o valor, e por quê. Teto de gasto é decisão de negócio: sem
  /// isto, quem abrir a tela seis meses depois não tem a quem perguntar.
  definidoPorId String?
  definidoEm    DateTime @default(now())
  motivo        String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// O consumo de IA de uma empresa em UM dia — o livro-caixa do teto.
///
/// Uma linha por (empresa, dia). É ela que responde "quanto já foi gasto hoje"
/// sem varrer `SessionStep`, e é nela que a RESERVA acontece.
///
/// POR QUE RESERVA, E NÃO SÓ SOMA DO QUE JÁ FOI GASTO
/// O custo de uma chamada só se conhece DEPOIS dela. Uma conferência que olhe
/// apenas o já gasto corta tarde por construção: a chamada que estoura o teto é
/// justamente a que ainda não foi contada. Então, antes de chamar o modelo, o
/// serviço soma a ESTIMATIVA em `reservadoUsd` — e só soma se o total couber no
/// teto. Depois da resposta, a reserva vira gasto pelo valor REAL. Chamada que
/// falha devolve a reserva.
///
/// A reserva também é o que segura duas chamadas SIMULTÂNEAS: a soma acontece
/// numa única instrução `INSERT ... ON CONFLICT DO UPDATE ... WHERE`, então a
/// segunda enxerga a reserva da primeira mesmo que as duas tenham lido o mesmo
/// saldo um instante antes.
///
/// POR QUE `dia` É TEXTO E NÃO `date`
/// Porque não é um instante, é um RÓTULO DE CALENDÁRIO no fuso da empresa
/// (`AAAA-MM-DD`). Gravado como `date`, o driver o devolve como `Date` no fuso
/// do processo e a data volta trocada num container em UTC — o defeito exato
/// que o campo existe para evitar.
model GastoDeIaNoDia {
  id    String @id @default(uuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  /// `AAAA-MM-DD` no fuso de `TetoDeCustoIa.fusoHorario`.
  dia String

  /// Custo REAL, o que o provedor informou. Separado do estimado de propósito:
  /// misturar os dois apagaria a procedência do número (09-PADRÕES).
  gastoUsd Decimal @default(0) @db.Decimal(12, 6)

  /// Estimativa das chamadas cujo custo real não volta para cá — hoje,
  /// `complete()`, que devolve texto e não uso. A tela mostra os dois, e nunca
  /// soma um R$ 0,00 inventado no lugar do que não foi medido.
  gastoEstimadoUsd Decimal @default(0) @db.Decimal(12, 6)

  /// Reservas ainda abertas (chamadas em voo). Volta a zero quando todas
  /// liquidam. Valor teimosamente alto aqui é chamada que nunca liquidou —
  /// processo morto no meio — e é por isso que ele é um campo, não uma conta.
  reservadoUsd Decimal @default(0) @db.Decimal(12, 6)

  chamadas Int @default(0)
  /// Chamadas em modelo fora da tabela de preço: não dá para estimar nem
  /// medir. Elas passam, e ficam contadas aqui para a tela dizer "não medido".
  chamadasSemPreco Int @default(0)
  /// Quantas vezes o teto recusou uma chamada neste dia.
  cortes           Int @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([orgId, dia])
}

// ===========================================================================
// FATIA 5.3 — O COFRE: SEGREDO POR EMPRESA E POR CONECTOR (RF-C-01..RF-C-04)
//
// Acrescentado no FIM do arquivo de propósito, e SEM `prisma migrate dev`: duas
// fatias desta onda mexem no mesmo schema, e tanto reescrever o arquivo quanto
// gerar a migration automaticamente engoliria os modelos da outra (protocolo da
// onda 7, seção 4). O SQL desta tabela foi escrito à mão, com carimbo próprio,
// e provado no banco `prova_53`.
//
// O PROBLEMA QUE ESTA TABELA EXISTE PARA RESOLVER. Até 11/09/2026 havia UMA
// chave de ambiente (`ENCRYPTION_KEY`) cifrando todo segredo do produto, e ela
// nem sequer alcançava tudo: `BioConexao` e `BioCredencialApp` eram cifrados,
// `GoogleAccount.accessToken`/`refreshToken` e `MetaAccount.userToken`/
// `pageToken` estavam em TEXTO PURO no banco. Trocar aquela chave tornava
// ilegível, de uma vez, tudo o que estava cifrado — está documentado no
// CLAUDE.md do projeto como armadilha conhecida, e `prisma/migrate-bio.ts`
// precisou de um `BIO_OLD_ENCRYPTION_KEY` para contornar a mesma coisa uma vez.
//
// O QUE MUDA AQUI: cada valor guarda O ID DA CHAVE QUE O CIFROU (`chaveId`), e
// o cofre carrega um CHAVEIRO com várias chaves ao mesmo tempo
// (`src/common/crypto.ts`). Rotacionar passa a ser re-cifrar linha a linha para
// a chave nova — e, enquanto a chave velha continuar no chaveiro, a linha que a
// rotação ainda NÃO tocou continua abrindo. É o que separa rotação de "perder
// tudo de uma vez".
// ===========================================================================

/// Um segredo de UMA empresa para UM conector — o que o cofre guarda.
///
/// GRANULARIDADE: (empresa, conector, nome). O `nome` é qual segredo dentro do
/// conector — `access_token`, `refresh_token`, `app_secret` — e existe porque
/// revogar tem de poder alcançar UM deles: um refresh token queimado não
/// obriga a apagar o app secret do mesmo conector.
///
/// POR QUE NÃO UMA COLUNA NOVA EM `GoogleAccount`/`BioConexao`. Porque a
/// pergunta "quais segredos esta empresa tem, e com que chave cada um está
/// cifrado?" é a pergunta da ROTAÇÃO, e ela não pode depender de varrer sete
/// tabelas diferentes com sete formatos de coluna. Um lugar só, com índice por
/// `chaveId`, responde "o que ainda falta rotacionar" numa consulta.
///
/// O QUE **NÃO** ESTÁ AQUI, e de propósito: segredo de PLATAFORMA — a
/// `ENCRYPTION_KEY`, a chave da Anthropic, o app global da Root
/// (`BioCredencialApp` com `orgId` nulo). Este cofre é por EMPRESA: a coluna
/// `orgId` é obrigatória, o isolamento por linha recorta por ela, e uma linha
/// sem empresa não teria como ser recortada. Segredo de plataforma continua em
/// variável de ambiente, que é onde o operador o administra.
model SegredoDeConector {
  id    String @id @default(uuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])

  /// Chave do catálogo de conectores (`CONNECTORS`, em `packages/shared`) —
  /// `gmail`, `clickup`, `instagram`… A MESMA chave que o interruptor de
  /// desligamento usa (`integrations/conectores.ts`), para que desligar e
  /// revogar falem do mesmo conector sem tradução no meio.
  conector String

  /// Qual segredo dentro do conector. Texto livre e não enum: o conjunto muda
  /// com cada API externa (`access_token`, `refresh_token`, `app_secret`,
  /// `acesso:<idDaConexao>`), e um enum viraria migration de tipo a cada
  /// conector novo. Ver `NOMES_CONHECIDOS` em `src/cofre/segredo.ts`.
  nome String

  /// O valor, cifrado com AES-256-GCM. O formato carrega a versão e o ID DA
  /// CHAVE (`c2.<chaveId>.<iv>.<tag>.<dados>`), e o GCM autentica com
  /// `orgId|conector|nome` como dado associado — uma linha copiada para outra
  /// empresa NÃO ABRE, mesmo com a chave certa. É a segunda tranca por cima do
  /// isolamento por linha, e ela vale até contra quem tem acesso ao dump.
  valorCifrado String

  /// Qual chave do chaveiro cifrou ESTE valor. É a coluna que torna a rotação
  /// possível sem parar o mundo: as linhas migram uma a uma, e as que ainda não
  /// migraram continuam legíveis porque a chave antiga segue no chaveiro.
  chaveId String

  /// O que a credencial emprestada PERMITE. Vazio = sem restrição declarada
  /// (o estado do que veio migrado de antes do cofre). Quem empresta pode
  /// exigir um escopo, e o cofre recusa quando ele não está aqui — é o "capacidade
  /// com escopo" do RF-C-02.
  escopo String[] @default([])

  /// De onde este segredo veio: `oauth`, `tela`, `migracao:bio`,
  /// `migracao:google`, `migracao:meta`. É o que permite DESFAZER a migração
  /// sem adivinhação (ver `src/cofre/migrar-credenciais.ts`).
  origem String

  /// Quando o segredo EM SI expira (o token OAuth), não o empréstimo. Nulo =
  /// não expira ou não se sabe. O cofre não apaga o que expirou: quem renova é
  /// o conector, e apagar tiraria dele o refresh token.
  expiraEm DateTime?

  /// Sobe a cada gravação de valor novo. Serve à auditoria ("este segredo já
  /// foi trocado três vezes") e ao diagnóstico de conector que renova em laço.
  versao Int @default(1)

  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt
  /// Última vez que a ROTAÇÃO re-cifrou esta linha. Diferente de
  /// `atualizadoEm`: rotação não muda o segredo, só a chave que o embrulha.
  rotacionadoEm DateTime?
  /// Última vez que o cofre EMPRESTOU este segredo. Segredo que nunca foi
  /// emprestado é candidato a revogação — e é a única coisa que o cofre sabe
  /// sobre o uso, porque ele não vê a chamada externa.
  usadoEm       DateTime?

  /// REVOGAÇÃO (RF-C-03). A linha SOBREVIVE à revogação e o valor NÃO: ao
  /// revogar, `valorCifrado` vira string vazia e estes três campos são
  /// preenchidos. É de propósito nos dois sentidos —
  ///
  ///  · apagar o valor é o que faz a revogação ter EFEITO IMEDIATO de verdade.
  ///    Uma revogação que fosse só uma flag dependeria de todo leitor lembrar
  ///    de conferi-la; o leitor que esquecesse continuaria mandando mensagem
  ///    com a credencial revogada. Sem valor não há o que ler.
  ///  · manter a linha é o que deixa a auditoria responder "quem revogou, quando
  ///    e por quê" — e é o que impede que o mesmo segredo seja regravado sem
  ///    passar por cima de um registro visível.
  ///
  /// NÃO CONFUNDIR COM `ConectorDesligado` (fatia 3.7). Desligar é PAUSA e não
  /// toca credencial nenhuma: religar devolve o conector ao ar sem novo OAuth.
  /// Revogar é QUEIMAR: o segredo some, e voltar exige autorizar de novo. Os
  /// dois existem porque as duas perguntas existem.
  revogadoEm      DateTime?
  revogadoPor     String?
  motivoRevogacao String?

  /// Um segredo por (empresa, conector, nome). Guardar dois seria guardar um
  /// que ninguém sabe qual é — e a revogação deixaria o outro vivo.
  @@unique([orgId, conector, nome])
  /// A consulta da ROTAÇÃO: "o que ainda está na chave velha?". Sem ele, toda
  /// rotação varre a tabela inteira para descobrir o que já migrou.
  @@index([chaveId])
}
