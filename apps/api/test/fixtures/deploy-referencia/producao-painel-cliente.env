# ROOT OS — instância 'producao' — gerado por deploy/instalar.sh em <DATA>
# 0600. Este arquivo é a verdade desta instância; o compose lê daqui. Nunca versionar.
ROOTOS_AMBIENTE=producao
ROOTOS_PROJECT=root_rootos-prod
ROOTOS_PAINEL=root/rootos-prod
ROOTOS_CONTAINER_PREFIX=rootos_prod
ROOTOS_NETWORK_NAME=rootos-producao-net
ROOTOS_IMAGE=rootos-app:v1-<COMMIT12>
ROOTOS_BIND_IP=172.16.0.1
ROOTOS_VERSION=v1
ROOTOS_COMMIT=<COMMIT>
WEB_HOST_PORT=4000
API_HOST_PORT=4001
DB_PORT=5442
REDIS_PORT=6390
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
# --- banco (dona das tabelas; o papel restrito é operação posterior: deploy/papel-app.sh) ---
DB_USER=rootos
DB_PASSWORD=010101010101010101010101010101010101010101010101
DB_NAME=rootos_producao
DB_APP_USER=
DB_APP_PASSWORD=
# --- segredos gerados ---
JWT_SECRET=0202020202020202020202020202020202020202020202020202020202020202
AUTH_SECRET=0303030303030303030303030303030303030303030303030303030303030303
ENCRYPTION_KEY=0404040404040404040404040404040404040404040404040404040404040404
COFRE_CHAVES=
COFRE_CHAVE_ATUAL=
S3_ACCESS_KEY=rootos
S3_SECRET_KEY=050505050505050505050505050505050505050505050505
CANAL_APROVACAO_SEGREDO=
CANAL_APROVACAO_CODIGO_SEGREDO=
CANAL_APROVACAO_CAPACIDADES=
# --- endereços ---
WEB_ORIGIN=https://os.cliente.teste
PUBLIC_BASE_URL=https://os.cliente.teste
PUBLIC_BIO_ORIGIN=https://os.cliente.teste
# --- login com Google (o admin do cliente entra por aqui; o callback serve ao login e ao conector) ---
GOOGLE_CLIENT_ID=id-sintetico
GOOGLE_CLIENT_SECRET=segredo-google-sintetico
GOOGLE_REDIRECT_URI=https://os.cliente.teste/api/google/callback
GOOGLE_LOGIN_ALLOWED_EMAILS=dono@acme.com.br
# --- modelo (o provedor segue a chave que veio; sem chave, o LLM fica desligado e a instância diz isso) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-sintetica
OPENAI_API_KEY=
# --- a porta e o relógio (calibragem começa observando) ---
GATEWAY_MODO=observar
TENANT_MODO=observar
ROTINAS_CRON=on
OBSIDIAN_REINDEX_MIN=0
OBSIDIAN_VAULT_HOST=<BASE>/producao/vault
RASTRO_RETENCAO_DIAS=1825
BACKUP_DIR=<BASE>/producao/backups
