ROOTOS_CONTAINER_PREFIX=rootos_homolog
ROOTOS_NETWORK_NAME=rootos-homologacao-net
ROOTOS_IMAGE=rootos-app:v1-<COMMIT12>
ROOTOS_BIND_IP=172.16.0.1
