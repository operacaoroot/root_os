#!/usr/bin/env bash
# STUB de `docker` para a suíte hermética (apps/api/test/deploy-instancia.test.ts).
# Registra cada invocação em $STUB_LOG e responde o mínimo que os scripts precisam.
# Nunca sobe nada. Comportamentos controlados por variáveis STUB_*.
set -u
printf 'docker %s\n' "$*" >> "${STUB_LOG:?}"
sub="${1:-}"; shift || true
case "$sub" in
  compose)
    # extrai os -f para achar o override (o último -f) e o subcomando
    files=(); cmd=""; rest=()
    while [ $# -gt 0 ]; do
      case "$1" in
        -f) files+=("$2"); shift 2 ;;
        -p|--project-directory|--env-file) shift 2 ;;
        version|build|up|run|ps|logs|exec) cmd="$1"; shift; rest=("$@"); break ;;
        *) shift ;;
      esac
    done
    case "$cmd" in
      version) exit 0 ;;
      build)
        [ "${STUB_FAIL_BUILD:-0}" = 1 ] && exit 1
        override="${files[${#files[@]}-1]}"
        # [[:space:]] e não \s: o grep/sed do macOS não entendem \s em ERE
        img="$(grep -m1 -E '^[[:space:]]*image:' "$override" | sed -E 's/^[[:space:]]*image:[[:space:]]*//' | tr -d '[:space:]')"
        printf '%s\n' "$img" >> "${STUB_IMAGES:?}"
        exit 0 ;;
      up)
        case " ${rest[*]} " in *" --no-build api web "*) [ "${STUB_FAIL_UP:-0}" = 1 ] && exit 1 ;; esac
        exit 0 ;;
      run)
        joined="${rest[*]}"
        case "$joined" in
          *"migrate deploy"*) [ "${STUB_FAIL_MIGRATE_REAL:-0}" = 1 ] && exit 1 ;;
          *"seed:politica"*)  [ "${STUB_FAIL_POLITICA:-0}" = 1 ] && exit 1 ;;
        esac
        exit 0 ;;
      *) exit 0 ;;
    esac ;;
  image)
    [ "${1:-}" = inspect ] || exit 0
    grep -qxF "${2:-}" "${STUB_IMAGES:?}" 2>/dev/null && exit 0 || exit 1 ;;
  exec)
    joined="$*"
    case "$joined" in
      *pg_isready*) exit 0 ;;
      *_prisma_migrations*)
        [ "${STUB_FAIL_PSQL:-0}" = 1 ] && exit 1
        printf '%s' "${STUB_APPLIED:-}" | tr ',' '\n'; echo; exit 0 ;;
      *"CREATE DATABASE"*|*"DROP DATABASE"*|*pg_dump*) exit 0 ;;
      *) exit 0 ;;
    esac ;;
  run)
    joined="$*"
    case "$joined" in
      *rootos-app:v1-*"pnpm smoke"*) [ "${STUB_FAIL_ANTIGA:-0}" = 1 ] && exit 1 ;;
      *"pnpm smoke"*) [ "${STUB_FAIL_ENSAIO:-0}" = 1 ] && exit 1 ;;
    esac
    exit 0 ;;
  tag) exit 0 ;;
  *) exit 0 ;;
esac
