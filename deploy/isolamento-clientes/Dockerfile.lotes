ARG BASE_IMAGE=rootos-official:bio-ritmo-2c45bf4
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
WORKDIR /app
COPY packages/shared/src/ packages/shared/src/
COPY apps/api/src/ apps/api/src/
COPY apps/api/prisma/ apps/api/prisma/
COPY apps/api/test/ apps/api/test/
COPY apps/web/src/ apps/web/src/
COPY apps/web/tests/ apps/web/tests/
RUN export NODE_OPTIONS=--max-old-space-size=4096 \
 && pnpm --filter @mktos/shared build \
 && pnpm --filter @mktos/api db:generate \
 && pnpm --filter @mktos/api build \
 && pnpm --filter @mktos/web build
WORKDIR /app/apps/api
