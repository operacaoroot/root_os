ARG BASE_IMAGE=rootos-official:etapa9-1422e90
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
WORKDIR /app
COPY packages/shared/src/ packages/shared/src/
COPY apps/api/src/ apps/api/src/
COPY apps/api/prisma/ apps/api/prisma/
COPY apps/api/package.json apps/api/tsconfig*.json apps/api/
COPY apps/web/src/ apps/web/src/
RUN export NODE_OPTIONS=--max-old-space-size=4096 \
 && pnpm --filter @mktos/shared build \
 && pnpm --filter @mktos/api db:generate \
 && pnpm --filter @mktos/api build \
 && pnpm --filter @mktos/web build
COPY apps/api/test/ apps/api/test/
COPY apps/api/scripts/ apps/api/scripts/
COPY apps/api/vitest.config.ts apps/api/
COPY apps/web/tests/ apps/web/tests/
WORKDIR /app/apps/api
