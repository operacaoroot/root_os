# Copie para homolog/.env.homolog (ignorado pelo git) e preencha.
# Segredos de desenvolvimento: gere com  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TAILSCALE_IP=100.95.41.124
WEB_PORT=3010
API_PORT=4010
DB_PORT=5440
REDIS_PORT=6391
MINIO_PORT=9012
MINIO_CONSOLE_PORT=9013
ASAAS_MOCK_PORT=4011
ZAPSIGN_MOCK_PORT=4012

DB_USER=rootos
DB_PASSWORD=
DB_NAME=rootos_comercial

JWT_SECRET=
AUTH_SECRET=
ENCRYPTION_KEY=
ADMIN_PASSWORD=

WEB_ORIGIN=http://100.95.41.124:3010
PUBLIC_BASE_URL=http://100.95.41.124:3010
GATEWAY_MODO=impor

# Inteligência: stub | ponte | anthropic
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1

# Dinheiro e assinatura: dublês por padrão (ver docker-compose.comercial.yml)
ASAAS_API_KEY=
ASAAS_BASE_URL=
ZAPSIGN_API_TOKEN=
ZAPSIGN_BASE_URL=
# Segredo do cabeçalho do webhook (asaas-access-token / x-zapsign-token). O mesmo
# valor vai ao dublê e à API. Obrigatórios: o compose recusa subir sem eles (não
# há valor de reserva). Gere cada um com
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# e use um valor diferente para cada webhook.
ASAAS_WEBHOOK_TOKEN=
ZAPSIGN_WEBHOOK_TOKEN=

# WhatsApp: simulado | evolution | meta
WHATSAPP_PROVEDOR=simulado
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=

# Banco de teste (nome precisa conter "test")
TEST_DATABASE_URL=postgresql://rootos:${DB_PASSWORD}@127.0.0.1:5440/rootos_comercial_test
